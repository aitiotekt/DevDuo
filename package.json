{
  "name": "devduo",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Pesudo iPhone Duo Viewport Simulator for Web Developers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:aitiotekt/DevDuo.git"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b --pretty false",
    "typecheck:scripts": "tsc -b tsconfig.scripts.json --pretty false",
    "typecheck:tests": "tsc -b tsconfig.tests.json --pretty false",
    "typecheck:docsite": "tsc -p docsite/tsconfig.json --pretty false",
    "test": "node --test scripts/__tests__/*.test.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26",
    "@types/semver": "^7.8.0",
    "chii": "1.15.5",
    "chobitsu": "1.8.6",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
