+String hostTouchStateForFrame(LocalFrame& frame)
+{
+    auto describe = [](RenderObject* renderer) -> String {
+        if (!renderer)
+            return "missing"_s;
+        auto& style = renderer->style();
+        return makeString("touch="_s, Style::toPlatform(style.usedTouchAction()).toRaw(),
+            ", listeners="_s, style.eventListenerRegionTypes().toRaw());
+    };
+    RefPtr document = frame.document();
+    auto* view = document ? document->renderView() : nullptr;
+    auto* element = document && document->documentElement() ? document->documentElement()->renderer() : nullptr;
+    auto* layer = view ? view->layer() : nullptr;
+    auto* backing = layer ? layer->backing() : nullptr;
+    auto description = makeString("\nnative render style: view "_s, describe(view), "; element "_s, describe(element),
+        "; needs region "_s, backing && backing->needsEventRegionUpdate() ? "yes"_s : "no"_s,
+        "; maintains region "_s, backing && backing->maintainsEventRegion() ? "yes"_s : "no"_s, "\n"_s);
+    RefPtr coordinator = frame.page() ? dynamicDowncast<AsyncScrollingCoordinator>(frame.page()->scrollingCoordinator()) : nullptr;
+    RefPtr tree = coordinator ? coordinator->scrollingTree() : nullptr;
+    if (!tree)
+        return description;
+    Locker treeLocker { tree->treeLock() };
+    RefPtr root = tree->rootNode();
+    if (!root)
+        return description;
+    RefPtr mirrorRoot = static_cast<ScrollingTreeFrameScrollingNodeCoordinated*>(root.get())->rootContentsLayer();
+    TextStream stream;
+    stream << "WC hit-test mirror root, scroll " << tree->mainFrameScrollPosition() << "\n";
+    Vector<std::pair<Ref<ScrollingLayerWC>, unsigned>> pending;
+    if (mirrorRoot)
+        pending.append({ mirrorRoot.releaseNonNull(), 0 });
+    unsigned visited = 0;
+    while (!pending.isEmpty() && visited++ < 256) {
+        auto [current, depth] = pending.takeLast();
+        Locker layerLocker { current->lock() };
+        stream << "depth " << depth << " layer " << current->identifier() << " node " << current->scrollingNodeID()
+            << " position " << current->position() << " bounds " << current->bounds() << "\n";
+        for (auto& child : current->children())
+            pending.append({ child, depth + 1 });
+    }
+    return makeString(description, stream.release());
+}
+
+bool hostScrollingTreeHasRoot(ThreadedScrollingTree& tree)
+{
+    Locker locker { tree.treeLock() };
+    return !!tree.rootNode();
+}
+
+void stopHostTouchScrolling(ThreadedScrollingTree& tree, const PlatformWheelEvent& event)
+{
+    ASSERT(ScrollingThread::isCurrentThread());
+    tree.stopHostTouchScrolling(event);
+}
+
+uint8_t hostTouchActionsAtPoint(LocalFrame& frame, const IntPoint& rootViewPoint)
+{
+    RefPtr view = frame.view();
+    if (!view)
+        return 0;
+    auto point = view->rootViewToContents(rootViewPoint);
+    auto result = frame.eventHandler().hitTestResultAtPoint(point, { HitTestRequest::Type::ReadOnly, HitTestRequest::Type::AllowChildFrameContent });
+    RefPtr node = result.innerNode();
+    CheckedPtr renderer = node ? node->renderer() : nullptr;
+    return renderer ? Style::toPlatform(renderer->style().usedTouchAction()).toRaw() : 0;
+}
+}
+#endif
