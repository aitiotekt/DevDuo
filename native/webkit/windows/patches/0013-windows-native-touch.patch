+void ScrollingTree::stopHostTouchScrolling(const PlatformWheelEvent& event)
+{
+    Locker locker { m_treeLock };
+    RefPtr node = nodeForID(latchedNodeID());
+    if (!node && rootNode()) {
+        // A zero-delta Began does not latch a node. Cancel still has to stop
+        // inertia on the original hit chain, including nested scroll targets.
+        auto position = rootNode()->viewToContentsPoint(event.position(), mainFrameScrollPosition());
+        node = scrollingNodeForPoint(position);
+    }
+    while (node) {
+        if (RefPtr scrollingNode = dynamicDowncast<ScrollingTreeScrollingNode>(node))
+            scrollingNode->stopAnimatedScroll(AnimatedScrollType::User);
+        if (RefPtr proxy = dynamicDowncast<ScrollingTreeOverflowScrollProxyNode>(node)) {
+            if (RefPtr related = nodeForID(proxy->overflowScrollingNodeID())) {
+                node = WTF::move(related);
+                continue;
+            }
+        }
+        node = node->parent();
+    }
+}
