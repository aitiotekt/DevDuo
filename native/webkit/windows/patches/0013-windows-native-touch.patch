diff --git a/Source/WebKit/UIProcess/win/WebViewHostTouch.cpp b/Source/WebKit/UIProcess/win/WebViewHostTouch.cpp
new file mode 100644
--- /dev/null
+++ b/Source/WebKit/UIProcess/win/WebViewHostTouch.cpp
@@ -0,0 +1,247 @@
+#include "config.h"
+#include "WebView.h"
+
+#if ENABLE(TOUCH_EVENTS) && ENABLE(ASYNC_SCROLLING)
+
+#include "NativeWebMouseEvent.h"
+#include "WebEventFactory.h"
+#include <WebCore/TouchAction.h>
+#include <cmath>
+#include <wtf/text/MakeString.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+void WebView::setHostTouchEnabled(bool enabled)
+{
+    if (m_hostTouchEnabled == enabled)
+        return;
+    cancelHostTouch();
+    m_hostTouchEnabled = enabled;
+    m_page->setHostTouchEnabled(enabled);
+}
+
+void WebView::sendHostTouch(WebEventType type, const WebEventData& input, DoublePoint point, DoublePoint global)
+{
+    if (!m_hostTouchContact || m_page->isClosed() || !m_page->hasRunningProcess())
+        return;
+    auto state = WebPlatformTouchPoint::State::Moved;
+    switch (type) {
+    case WebEventType::TouchStart: state = WebPlatformTouchPoint::State::Pressed; break;
+    case WebEventType::TouchEnd: state = WebPlatformTouchPoint::State::Released; break;
+    case WebEventType::TouchCancel: state = WebPlatformTouchPoint::State::Cancelled; break;
+    default: break;
+    }
+    WebTouchEventInit init;
+    init.event = input;
+    init.event.type = type;
+    auto identifier = m_hostTouchContact->identifier;
+    init.touch.touchPoints.append(WebPlatformTouchPoint(static_cast<uint32_t>(identifier), state, global, point, DoubleSize(8, 8), 0, type == WebEventType::TouchEnd || type == WebEventType::TouchCancel ? 0 : 0.5));
+    m_page->handleTouchEvent(nullptr, NativeWebTouchEvent::createHostTouch(WTF::move(init), identifier));
+}
+
+void WebView::sendHostPan(const WebEventData& input, DoublePoint point, DoublePoint global, FloatSize delta, WebEventPhase phase)
+{
+    if (m_page->isClosed() || !m_page->hasRunningProcess())
+        return;
+    if (phase == WebEventPhase::Began)
+        m_hostPanBeginInputSeconds = input.hostInputSeconds;
+    if (phase == WebEventPhase::Ended)
+        m_hostPanEndInputSeconds = input.hostInputSeconds;
+    WebWheelEventInit init;
+    init.event = input;
+    init.event.type = WebEventType::Wheel;
+    init.wheel.position = roundedIntPoint(point);
+    init.wheel.globalPosition = roundedIntPoint(global);
+    init.wheel.delta = delta;
+    init.wheel.granularity = WebWheelEventGranularity::ScrollByPixelWheelEvent;
+    init.wheel.phase = phase;
+    init.wheel.hasPreciseScrollingDeltas = true;
+    init.wheel.hostTouchGesture = true;
+    if (phase == WebEventPhase::Changed && delta.height()) {
+        int direction = delta.height() < 0 ? 1 : -1;
+        auto now = MonotonicTime::now();
+        if (direction != m_hostTouchDirection || now - m_hostTouchNotificationTime >= 100_ms) {
+            m_hostTouchDirection = direction;
+            m_hostTouchNotificationTime = now;
+            PostMessageW(m_window, WM_APP + 63, static_cast<WPARAM>(direction), static_cast<LPARAM>(m_hostContactGeneration));
+        }
+    }
+    m_page->handleNativeWheelEvent(NativeWebWheelEvent::createHostTouch(WTF::move(init)));
+}
+
+void WebView::cancelHostTouch()
+{
+    if (m_hostTouchContact && !m_hostTouchContact->panning) {
+        auto contact = *m_hostTouchContact;
+        sendHostTouch(WebEventType::TouchCancel, contact.input, contact.current, contact.global);
+    }
+    if (m_hostLastPan) {
+        auto pan = *m_hostLastPan;
+        pan.input.timestamp = MonotonicTime::now();
+        pan.input.hostInputSeconds = hostFrameClockSeconds();
+        pan.input.hostInputSequence = ++m_hostInputSequence;
+        sendHostPan(pan.input, pan.start, pan.globalStart, { }, WebEventPhase::Cancelled);
+        m_hostLastPan.reset();
+    }
+    m_hostTouchContact.reset();
+    ++m_hostContactGeneration;
+    m_hostTouchDirection = 0;
+    if (m_window && GetCapture() == m_window)
+        ReleaseCapture();
+}
+
+bool WebView::onHostTouchMouseEvent(HWND window, UINT message, WPARAM wParam, LPARAM lParam)
+{
+    if (message == WM_MOUSELEAVE)
+        return true;
+    if (message != WM_LBUTTONDOWN && message != WM_LBUTTONDBLCLK && message != WM_LBUTTONUP && message != WM_MOUSEMOVE)
+        return true;
+    if (message == WM_MOUSEMOVE) {
+        if (!m_hostTouchContact || !m_hostTouchContact->down)
+            return true;
+        // Capture changes can leave a contact without its button-up message.
+        // A buttonless move ends it before any coordinate or scroll update.
+        if (!(wParam & MK_LBUTTON)) {
+            cancelHostTouch();
+            return true;
+        }
+    }
+    auto mouse = WebEventFactory::createWebMouseEvent(window, message, wParam, lParam, false, m_page->intrinsicDeviceScaleFactor());
+    // Windows also posts WM_MOUSEMOVE when the window changes under a stationary
+    // cursor. A single emulated contact has no changing pressure/tilt payload;
+    // identical coordinates must not wake page touch handlers or overwrite the
+    // last real movement timestamp.
+    if (message == WM_MOUSEMOVE && m_hostTouchContact && m_hostTouchContact->current == mouse.mouse.position)
+        return true;
+    mouse.event.hostInputSequence = ++m_hostInputSequence;
+    mouse.event.hostInputSeconds = hostFrameClockSeconds();
+    if (message == WM_LBUTTONDOWN || message == WM_LBUTTONDBLCLK) {
+        cancelHostTouch();
+        m_hostTouchContact.emplace();
+        auto& contact = *m_hostTouchContact;
+        contact.identifier = ++m_hostContactGeneration;
+        contact.start = contact.current = contact.previous = mouse.mouse.position;
+        contact.global = contact.globalStart = mouse.mouse.globalPosition;
+        contact.input = contact.startInput = mouse.event;
+        ++m_hostTouchContacts;
+        SetFocus(window);
+        SetCapture(window);
+        sendHostTouch(WebEventType::TouchStart, mouse.event, mouse.mouse.position, mouse.mouse.globalPosition);
+        return true;
+    }
+    if (!m_hostTouchContact)
+        return true;
+    auto& contact = *m_hostTouchContact;
+    contact.input = mouse.event;
+    contact.current = mouse.mouse.position;
+    contact.global = mouse.mouse.globalPosition;
+    contact.moved |= std::hypot(contact.current.x() - contact.start.x(), contact.current.y() - contact.start.y()) >= 6;
+    if (message == WM_LBUTTONUP)
+        contact.down = false;
+    if (contact.panning) {
+        auto actions = OptionSet<TouchAction>::fromRaw(contact.actions);
+        bool unrestricted = actions.containsAny({ TouchAction::Auto, TouchAction::Manipulation });
+        FloatSize delta(unrestricted || actions.contains(TouchAction::PanX) ? contact.current.x() - contact.previous.x() : 0,
+            unrestricted || actions.contains(TouchAction::PanY) ? contact.current.y() - contact.previous.y() : 0);
+        contact.previous = contact.current;
+        if (!delta.isZero())
+            sendHostPan(mouse.event, contact.start, contact.globalStart, delta, WebEventPhase::Changed);
+        if (!contact.down) {
+            sendHostPan(mouse.event, contact.start, contact.globalStart, { }, WebEventPhase::Ended);
+            m_hostTouchContact.reset();
+        }
+    } else
+        sendHostTouch(contact.down ? WebEventType::TouchMove : WebEventType::TouchEnd, mouse.event, contact.current, contact.global);
+    if (message == WM_LBUTTONUP && GetCapture() == window)
+        ReleaseCapture();
+    return true;
+}
+
+void WebView::doneWithHostTouchEvent(const NativeWebTouchEvent& event, bool handled)
+{
+    if (!m_hostTouchEnabled || !m_hostTouchContact || event.hostContact() != m_hostTouchContact->identifier)
+        return;
+    auto& contact = *m_hostTouchContact;
+    if (contact.panning || event.type() == WebEventType::TouchCancel)
+        return;
+    if (event.type() == WebEventType::TouchStart)
+        contact.actions = event.hostTouchActions();
+    if (handled && !contact.prevented)
+        ++m_hostTouchPrevented;
+    contact.prevented |= handled;
+    if (event.type() == WebEventType::TouchMove && contact.moved && !contact.prevented) {
+        auto actions = OptionSet<TouchAction>::fromRaw(contact.actions);
+        bool unrestricted = actions.containsAny({ TouchAction::Auto, TouchAction::Manipulation });
+        FloatSize delta(unrestricted || actions.contains(TouchAction::PanX) ? contact.current.x() - contact.start.x() : 0,
+            unrestricted || actions.contains(TouchAction::PanY) ? contact.current.y() - contact.start.y() : 0);
+        if (actions.contains(TouchAction::None) || delta.isZero())
+            return;
+        contact.panning = true;
+        m_hostLastPan = contact;
+        ++m_hostTouchPans;
+        sendHostTouch(WebEventType::TouchCancel, contact.input, contact.current, contact.global);
+        // Preserve the actual contact baseline. Using the newest move here
+        // collapses the first accumulated delta's time span and inflates inertia.
+        sendHostPan(contact.startInput, contact.start, contact.globalStart, { }, WebEventPhase::Began);
+        sendHostPan(contact.input, contact.start, contact.globalStart, delta, WebEventPhase::Changed);
+        contact.previous = contact.current;
+        if (!contact.down) {
+            sendHostPan(contact.input, contact.start, contact.globalStart, { }, WebEventPhase::Ended);
+            m_hostTouchContact.reset();
+        }
+        return;
+    }
+    if (event.type() != WebEventType::TouchEnd)
+        return;
+    auto completed = contact;
+    m_hostTouchContact.reset();
+    if (m_page->isClosed() || !m_page->hasRunningProcess())
+        return;
+    auto pointerID = mousePointerID + 1 + static_cast<uint32_t>(completed.identifier);
+    if (completed.moved || completed.prevented) {
+        m_page->touchWithIdentifierWasRemoved(pointerID);
+        return;
+    }
+    // Touch dispatch generated pointer/touch events already. This is the native
+    // compatibility mouse activation used by desktop WebKit's touch ports.
+    for (auto type : { WebEventType::MouseMove, WebEventType::MouseDown, WebEventType::MouseUp }) {
+        WebMouseEventInit click;
+        click.event = completed.input;
+        click.event.type = type;
+        click.mouse.position = completed.current;
+        click.mouse.globalPosition = completed.global;
+        click.mouse.button = type == WebEventType::MouseMove ? WebMouseEventButton::None : WebMouseEventButton::Left;
+        click.mouse.buttons = type == WebEventType::MouseDown ? 1 : 0;
+        click.mouse.clickCount = 1;
+        click.mouse.canInitiateDrag = PlatformMouseEvent::CanInitiateDrag::No;
+        click.mouse.syntheticClickType = WebMouseEventSyntheticClickType::OneFingerTap;
+        click.mouse.pointerType = touchPointerEventType();
+        click.mouse.pointerId = mousePointerID + 1 + static_cast<uint32_t>(completed.identifier);
+        m_page->handleMouseEvent(NativeWebMouseEvent::createHostTouch(WTF::move(click)));
+    }
+    ++m_hostTouchClicks;
+    // Mouse packets are queued; keep suppression/capture state until their
+    // native acknowledgements, then release the completed pointer.
+    Ref page = *m_page;
+    page->doAfterProcessingAllPendingMouseEvents([page, pointerID] {
+        if (!page->isClosed() && page->hasRunningProcess())
+            page->touchWithIdentifierWasRemoved(pointerID);
+    });
+}
+
+String WebView::hostTouchDiagnostics() const
+{
+    return makeString("{\"enabled\":"_s, m_hostTouchEnabled ? "true"_s : "false"_s,
+        ",\"generation\":"_s, m_hostContactGeneration,
+        ",\"active\":"_s, m_hostTouchContact ? "true"_s : "false"_s,
+        ",\"panning\":"_s, m_hostTouchContact && m_hostTouchContact->panning ? "true"_s : "false"_s,
+        ",\"touchActions\":"_s, m_hostTouchContact ? m_hostTouchContact->actions : 0,
+        ",\"contacts\":"_s, m_hostTouchContacts, ",\"pans\":"_s, m_hostTouchPans,
+        ",\"lastPanBeginInputSeconds\":"_s, String::number(m_hostPanBeginInputSeconds),
+        ",\"lastPanEndInputSeconds\":"_s, String::number(m_hostPanEndInputSeconds),
+        ",\"prevented\":"_s, m_hostTouchPrevented, ",\"compatibilityClicks\":"_s, m_hostTouchClicks, '}');
+}
+
+} // namespace WebKit
+#endif
