+
 void DrawingAreaProxyWC::discardBackingStore()
 {
+#if PLATFORM(WIN)
+    if (m_hostFrameSurfaceEnabled && m_hostAwaitingDisplayRefresh) {
+        // Keep the leased raw store alive until the host drains it. WebCore
+        // may accept new geometry while its prior presentation is pending.
+        m_hostDiscardAfterAck = true;
+        return;
+    }
+#endif
     m_backingStore = std::nullopt;
 #if PLATFORM(WIN)
     m_hostEdgeExpiryTimer.stop();
     m_hostEdges = { };
     m_hostPaintedEdges = { };
+    m_hostSharedTexture = 0; m_hostSurfaceStatus = 0;
+    m_hostSurfaceSize = { };
     std::fill(std::begin(m_hostEdgeDeadlines), std::end(m_hostEdgeDeadlines), 0);
 #endif
 }
