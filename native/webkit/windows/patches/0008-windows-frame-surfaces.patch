+    const auto& edge = m_hostEdges;
+    add(0, 0, width, edge.flowTop, edge.root);
+    add(0, edge.flowBottom, width, height, edge.root);
+    add(0, edge.flowTop, edge.flowLeft, edge.flowBottom, edge.root);
+    add(edge.flowRight, edge.flowTop, width, edge.flowBottom, edge.root);
+    const auto left = edge.insetLeft, right = width - edge.insetRight;
+    if (edge.colorMask & 1) add(left, 0, right, edge.insetTop, edge.top);
+    if (edge.colorMask & 4) add(left, height - edge.insetBottom, right, height, edge.bottom);
+    if (edge.colorMask & 2) add(right, 0, width, height, edge.right);
+    if (edge.colorMask & 8) add(0, 0, left, height, edge.left);
+    m_hostAcquiredSequence = m_hostSurfaceSequence;
+    m_hostFrameTiming.paintStartSeconds = MonotonicTime::now().secondsSinceEpoch().value();
+    return true;
+}
+void DrawingAreaProxyWC::acknowledgeHostFrameSurface(uint64_t sequence, bool presented)
+{
+    if (sequence != m_hostSurfaceSequence) return;
+    m_hostTransferredContentSequence = m_hostContentSequence;
+    if (presented) {
+        m_hostPaintedEdges = m_hostEdges;
+        m_hostFrameTiming.paintEndSeconds = MonotonicTime::now().secondsSinceEpoch().value();
+        if (m_hostPaintTimings.size() == 128) m_hostPaintTimings.removeAt(0);
+        m_hostPaintTimings.append(m_hostFrameTiming);
+    }
+    const bool refresh = std::exchange(m_hostAwaitingDisplayRefresh, false);
+    if (std::exchange(m_hostDiscardAfterAck, false)) discardBackingStore();
+    if (refresh) send(Messages::DrawingArea::DisplayDidRefresh(MonotonicTime::now()));
+}
