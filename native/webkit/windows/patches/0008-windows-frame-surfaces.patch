+#if PLATFORM(WIN)
+
+bool WCSceneContext::beginHostFrame(int width, int height)
+{
+    auto fail = [&](HRESULT error) { m_hostFrameStatus = static_cast<uint32_t>(error); return false; };
+    m_hostFrameStatus = 0;
+    if (!m_hostSharedFrame || m_hostSharedFrame->width != width || m_hostSharedFrame->height != height) {
+        m_hostSharedFrame = nullptr;
+        auto frame = makeUnique<HostSharedFrame>();
+        frame->display = eglGetCurrentDisplay();
+        auto queryDisplay = reinterpret_cast<PFNEGLQUERYDISPLAYATTRIBEXTPROC>(eglGetProcAddress("eglQueryDisplayAttribEXT"));
+        auto queryDevice = reinterpret_cast<PFNEGLQUERYDEVICEATTRIBEXTPROC>(eglGetProcAddress("eglQueryDeviceAttribEXT"));
+        EGLAttrib eglDevice = 0, devicePointer = 0;
+        if (!queryDisplay || !queryDevice || !queryDisplay(frame->display, EGL_DEVICE_EXT, &eglDevice)
+            || !queryDevice(reinterpret_cast<EGLDeviceEXT>(eglDevice), EGL_D3D11_DEVICE_ANGLE, &devicePointer) || !devicePointer)
+            return fail(E_NOINTERFACE);
+        auto* device = reinterpret_cast<ID3D11Device*>(devicePointer);
+        D3D11_TEXTURE2D_DESC description { };
+        description.Width = width; description.Height = height;
+        description.MipLevels = description.ArraySize = description.SampleDesc.Count = 1;
+        description.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        description.Usage = D3D11_USAGE_DEFAULT;
+        description.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+        description.MiscFlags = D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+        auto result = device->CreateTexture2D(&description, nullptr, &frame->texture);
+        if (FAILED(result)) return fail(result);
+        result = frame->texture.As(&frame->mutex);
+        if (FAILED(result)) return fail(result);
+        Microsoft::WRL::ComPtr<IDXGIResource> resource;
+        result = frame->texture.As(&resource);
+        if (FAILED(result)) return fail(result);
+        result = resource->GetSharedHandle(&frame->handle);
+        if (FAILED(result)) return fail(result);
+        Microsoft::WRL::ComPtr<IDXGIDevice> dxgi;
+        Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+        DXGI_ADAPTER_DESC adapterDescription { };
+        if (FAILED(device->QueryInterface(IID_PPV_ARGS(&dxgi))) || FAILED(dxgi->GetAdapter(&adapter))
+            || FAILED(adapter->GetDesc(&adapterDescription))) return fail(E_FAIL);
+        frame->adapterLuid = (static_cast<uint64_t>(static_cast<uint32_t>(adapterDescription.AdapterLuid.HighPart)) << 32)
+            | adapterDescription.AdapterLuid.LowPart;
+        const EGLint attributes[] = { EGL_WIDTH, width, EGL_HEIGHT, height, EGL_NONE };
+        frame->surface = eglCreatePbufferFromClientBuffer(frame->display, EGL_D3D_TEXTURE_ANGLE,
+            frame->texture.Get(), m_glContext->config(), attributes);
+        if (frame->surface == EGL_NO_SURFACE) return fail(E_NOTIMPL);
+        frame->width = width; frame->height = height;
+        m_hostSharedFrame = WTF::move(frame);
+    }
+    auto& frame = *m_hostSharedFrame;
+    auto result = frame.mutex->AcquireSync(0, 250);
+    if (result != S_OK) return fail(result == WAIT_TIMEOUT ? HRESULT_FROM_WIN32(WAIT_TIMEOUT) : E_FAIL);
+    frame.locked = true;
+    frame.previousDraw = eglGetCurrentSurface(EGL_DRAW);
+    frame.previousRead = eglGetCurrentSurface(EGL_READ);
+    frame.context = eglGetCurrentContext();
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &frame.previousFramebuffer);
+    glGetIntegerv(GL_VIEWPORT, frame.previousViewport);
+    if (!eglMakeCurrent(frame.display, frame.surface, frame.surface, frame.context)) {
+        frame.mutex->ReleaseSync(0); frame.locked = false;
+        return fail(E_FAIL);
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(0, 0, width, height);
+    return true;
+}
+
+uint64_t WCSceneContext::endHostFrame()
+{
+    auto& frame = *m_hostSharedFrame;
+    // ANGLE requires client rendering to finish before handing the mutex to a
+    // different device. This waits on the GPU worker, never the host UI thread.
+    // Fence-driven pipelining can replace this wait after transport is verified.
+    glFinish();
+    eglMakeCurrent(frame.display, frame.previousDraw, frame.previousRead, frame.context);
+    glBindFramebuffer(GL_FRAMEBUFFER, frame.previousFramebuffer);
+    glViewport(frame.previousViewport[0], frame.previousViewport[1], frame.previousViewport[2], frame.previousViewport[3]);
+    auto result = frame.mutex->ReleaseSync(1);
+    frame.locked = false;
+    if (FAILED(result)) { m_hostFrameStatus = static_cast<uint32_t>(result); return 0; }
+    return reinterpret_cast<uintptr_t>(frame.handle);
+}
+
+uint64_t WCSceneContext::hostFrameAdapterLuid() const
+{
+    return m_hostSharedFrame ? m_hostSharedFrame->adapterLuid : 0;
+}
