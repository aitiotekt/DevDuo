+void DrawingAreaProxyWC::replayHostFrameSurface(bool resourcesLost)
+{
+    if (!m_hostFrameSurfaceEnabled || m_hostSurfaceSize.isEmpty()) return;
+    if (resourcesLost) {
+        m_hostReplayKeyZero = m_hostTransferredContentSequence == m_hostContentSequence;
+        m_hostTransferredContentSequence = 0;
+    }
+    ++m_hostSurfaceSequence;
+    notifyHostFrameSurface();
+}
+bool DrawingAreaProxyWC::acquireHostFrameSurface(WKHostFrameSurface& output)
+{
+    if (!m_hostFrameSurfaceEnabled || m_hostSurfaceSize.isEmpty() || m_hostAcquiredSequence == m_hostSurfaceSequence)
+        return false;
+    output = { };
+    output.sequence = m_hostSurfaceSequence;
+    output.frameID = m_hostEdges.frameID; output.documentEpoch = m_hostEdges.documentEpoch;
+    output.adapterLuid = m_hostAdapterLuid;
+    output.sharedTexture = reinterpret_cast<void*>(static_cast<uintptr_t>(m_hostSharedTexture));
+    output.status = m_hostSurfaceStatus;
+    if (m_hostSurfaceIsStale) output.flags |= 4;
+    auto scale = m_hostSurfaceScale;
+    auto size = WebCore::expandedIntSize(m_hostSurfaceSize * scale);
+    output.width = size.width(); output.height = size.height(); output.background = m_hostEdges.root;
+    if (m_hostContentSequence != m_hostTransferredContentSequence) {
+        output.flags |= 1;
+        if (m_hostReplayKeyZero) output.flags |= 2;
+        if (!m_hostSharedTexture && !m_hostSurfaceStatus) {
+            size_t rowBytes = 0;
+            if (!m_backingStore || !m_backingStore->hostBitmapPixels(output.pixels, rowBytes)) return false;
+            output.rowBytes = static_cast<unsigned>(rowBytes);
+        }
+    }
+    auto add = [&](float left, float top, float right, float bottom, uint32_t rgb) {
+        left = std::clamp<float>(std::floor(left * scale + .5f), 0, output.width);
+        top = std::clamp<float>(std::floor(top * scale + .5f), 0, output.height);
+        right = std::clamp<float>(std::floor(right * scale + .5f), 0, output.width);
+        bottom = std::clamp<float>(std::floor(bottom * scale + .5f), 0, output.height);
+        if (right > left && bottom > top && output.fillCount < 8)
+            output.fills[output.fillCount++] = { left, top, right - left, bottom - top, rgb };
+    };
