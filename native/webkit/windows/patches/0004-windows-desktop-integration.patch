+    }
+    HRESULT STDMETHODCALLTYPE SetSelection(ULONG count, const TS_SELECTION_ACP* selection) override
+    {
+        if ((m_lock & TS_LF_READWRITE) != TS_LF_READWRITE) return TS_E_NOLOCK;
