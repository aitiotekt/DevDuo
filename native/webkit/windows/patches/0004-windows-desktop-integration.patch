+    }
+    String diagnostics() const { return String(std::span<const char16_t>(reinterpret_cast<const char16_t*>(m_trace.data()), m_trace.size())); }
+    unsigned state() const { return (m_activated ? 1u : 0u) | (m_composing ? 2u : 0u) | (m_hook ? 4u : 0u); }
