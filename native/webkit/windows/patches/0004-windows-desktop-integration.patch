+        if (iid == __uuidof(IUnknown) || iid == __uuidof(ITextStoreACP)) *object = static_cast<ITextStoreACP*>(this);
+        else if (iid == __uuidof(ITfContextOwnerCompositionSink)) *object = static_cast<ITfContextOwnerCompositionSink*>(this);
+        else if (iid == __uuidof(ITfTextEditSink)) *object = static_cast<ITfTextEditSink*>(this);
