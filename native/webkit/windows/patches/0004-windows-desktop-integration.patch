+    }
+    HRESULT STDMETHODCALLTYPE QueryInsert(LONG start, LONG end, ULONG count, LONG* resultStart, LONG* resultEnd) override
+    {
+        if (!resultStart || !resultEnd || !validRange(start, end) || count > static_cast<ULONG>(LONG_MAX - start)) return E_INVALIDARG;
+        *resultStart = start; *resultEnd = start + count; return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetSelection(ULONG index, ULONG count, TS_SELECTION_ACP* selection, ULONG* fetched) override
+    {
+        if (!m_lock) return TS_E_NOLOCK;
