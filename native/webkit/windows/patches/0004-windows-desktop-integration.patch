+        m_start = selection->acpStart; m_end = selection->acpEnd;
+        publishComposition(); return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetText(LONG start, LONG end, WCHAR* text, ULONG capacity, ULONG* copied, TS_RUNINFO* runs, ULONG runCapacity, ULONG* runCount, LONG* next) override
+    {
