+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return ++m_references; }
+    ULONG STDMETHODCALLTYPE Release() override { auto count = --m_references; if (!count) delete this; return count; }
+
+    HRESULT STDMETHODCALLTYPE AdviseSink(REFIID iid, IUnknown* unknown, DWORD mask) override
+    {
+        if (iid != __uuidof(ITextStoreACPSink) || !unknown) return E_INVALIDARG;
