+void WebPage::hostSetComposition(uint32_t operation, const String& text, uint32_t cursor, const Vector<uint8_t>& attributes)
+{
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (operation == 0) {
+        m_hostCompositionFrame = frame;
+        m_hostCompositionDocument = frame ? frame->document() : nullptr;
+        m_hostCompositionElement = frame && frame->document() ? frame->document()->focusedElement() : nullptr;
+        return;
+    }
+    RefPtr originalFrame = m_hostCompositionFrame.get();
+    RefPtr document = m_hostCompositionDocument.get();
+    RefPtr element = m_hostCompositionElement.get();
+    if (operation == 3 && originalFrame && document && originalFrame->document() == document
+        && (frame != originalFrame || document->focusedElement() != element)) {
+        // A new focused selection must never be replaced by the old composition.
+        // CancelComposition retires the old range without selecting it again.
+        Ref editor = originalFrame->editor();
+        if (element && editor->compositionNode() && editor->compositionNode()->isShadowIncludingDescendantOf(*element))
+            editor->cancelComposition();
+        m_hostCompositionFrame = nullptr;
+        m_hostCompositionDocument = nullptr;
+        m_hostCompositionElement = nullptr;
+        return;
+    }
+    if (!frame || frame != originalFrame || !document || frame->document() != document || frame->document()->focusedElement() != element || !frame->editor().canEdit())
+        return;
+    Ref editor = frame->editor();
+    if (operation == 1) {
+        Vector<CompositionUnderline> underlines;
+        // IMM attributes distinguish the selected conversion clause. Offsets are
+        // UTF-16, the same unit used by WebCore's native composition editor.
+        unsigned start = 0;
+        while (start < text.length()) {
+            bool thick = start < attributes.size() && (attributes[start] == 1 || attributes[start] == 3);
+            unsigned end = start + 1;
+            while (end < text.length() && (end < attributes.size() && (attributes[end] == 1 || attributes[end] == 3)) == thick)
+                ++end;
+            underlines.append({ start, end, CompositionUnderlineColor::TextColor, { }, thick });
+            start = end;
+        }
+        auto selection = std::min(cursor, text.length());
+        editor->setComposition(text, underlines, { }, { }, selection, selection);
+    } else {
+        if (operation == 2)
+            editor->confirmComposition(text);
+        else if (editor->hasComposition())
+            editor->setComposition(emptyString(), { }, { }, { }, 0, 0);
+        m_hostCompositionFrame = nullptr;
+        m_hostCompositionDocument = nullptr;
+        m_hostCompositionElement = nullptr;
+    }
+}
