+private:
+    ~HostTextStore() { deactivate(); }
+    void trace(const wchar_t* event, size_t value) { m_trace += event; m_trace += L":" + std::to_wstring(value) + L","; if (m_trace.size() > 2048) m_trace.erase(0, 1024); }
+    bool validRange(LONG start, LONG end) const { return start >= 0 && end >= start && static_cast<size_t>(end) <= m_text.size(); }
+    String string() const { return String(std::span<const char16_t>(reinterpret_cast<const char16_t*>(m_text.data()), m_text.size())); }
+    void publishComposition()
+    {
+        // An empty initial TSF range is not an Editor composition. Publishing
+        // it would terminate WebCore's session before the first real preedit.
+        if (m_text.empty() || !m_composing || m_closing || m_page->isClosed() || (m_lastText == m_text && m_lastCursor == m_end)) return;
