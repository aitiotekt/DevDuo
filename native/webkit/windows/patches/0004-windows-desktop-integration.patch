+void WebPage::getHostCaretRect(CompletionHandler<void(bool, const IntRect&, uint64_t)>&& callback)
+{
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (!frame || !frame->editor().canEdit()) {
+        callback(false, { }, 0);
+        return;
+    }
+    frame->view()->updateLayoutAndStyleIfNeededRecursive();
+    RefPtr element = frame->document()->focusedElement();
+    callback(true, frame->view()->contentsToRootView(frame->selection().absoluteCaretBounds()), element ? element->nodeIdentifier().toUInt64() : 0);
+}
+
+// Export WebCore's semantic AX tree, never a DOM approximation. Object IDs are
+// valid only with their owning document token; protected values stay private.
+void WebPage::getHostAccessibilityTree(CompletionHandler<void(const String&)>&& callback)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!document) {
+        callback(String());
+        return;
+    }
+    AXObjectCache::enableAccessibility();
+    frame->view()->updateLayoutAndStyleIfNeededRecursive();
+    auto* cache = document->axObjectCache();
+    RefPtr root = cache ? cache->rootObjectForFrame(*frame) : nullptr;
+    if (!root) {
+        callback(String());
+        return;
+    }
+    auto result = JSON::Object::create();
+    result->setString("document"_s, document->identifier().toString());
+    auto nodes = JSON::Array::create();
+    Vector<std::pair<Ref<AXCoreObject>, uint64_t>> pending;
+    pending.append({ *root, 0 });
+    HashSet<uint64_t> visited;
+    while (!pending.isEmpty()) {
+        auto [object, parent] = pending.takeLast();
+        auto id = object->objectID().toUInt64();
+        if (!visited.add(id).isNewEntry)
+            continue;
+        auto node = JSON::Object::create();
+        node->setString("id"_s, String::number(id));
+        node->setString("parent"_s, String::number(parent));
+        auto name = object->title();
+        if (name.isEmpty())
+            name = object->description();
+        // UIA reads ordinary text through Name, not an editable Value pattern.
+        if (name.isEmpty() && object->isStaticText())
+            name = object->stringValue();
+        if (name.isEmpty() && object->isWebArea())
+            name = document->title();
+        node->setString("name"_s, name);
+        node->setString("value"_s, object->isSecureField() ? String() : object->stringValue());
+        node->setString("description"_s, object->description());
+        // Stable platform roles, independent of WebCore's internal enum values.
+        unsigned role = 0x14; // ROLE_SYSTEM_GROUPING
+        if (object->isWebArea()) role = 0x0f;
+        else if ((object->role() == AccessibilityRole::TextField || object->role() == AccessibilityRole::TextArea || object->role() == AccessibilityRole::SearchField)) role = 0x2a;
+        else if (object->role() == AccessibilityRole::Button) role = 0x2b;
+        else if (object->isCheckbox() || object->isSwitch()) role = 0x2c;
+        else if (object->isRadioButton()) role = 0x2d;
+        else if ((object->isComboBox() || object->isPopUpButton())) role = 0x2e;
+        else if (object->isLink()) role = 0x1e;
+        else if (object->isImage()) role = 0x28;
+        else if (object->isStaticText()) role = 0x29;
+        else if (object->isListBox()) role = 0x21;
+        else if (object->isListBoxOption()) role = 0x22;
+        else if (object->isSlider()) role = 0x33;
+        else if (object->isProgressIndicator()) role = 0x30;
+        unsigned state = 0;
+        if (!object->isEnabled()) state |= 0x1;
+        if (object->isSelected()) state |= 0x2;
+        if (object->isFocused()) state |= 0x4;
+        if (object->isChecked()) state |= 0x10;
+        if (!object->canSetValueAttribute()) state |= 0x40;
+        if (!object->isVisible()) state |= 0x8000;
+        if (object->isOffScreen()) state |= 0x10000;
+        if (object->canSetFocusAttribute()) state |= 0x100000;
+        if (object->isSecureField()) state |= 0x20000000;
+        node->setInteger("role"_s, role);
+        node->setInteger("state"_s, state);
+        auto rect = enclosingIntRect(object->relativeFrame());
+        node->setInteger("x"_s, rect.x());
+        node->setInteger("y"_s, rect.y());
+        node->setInteger("width"_s, rect.width());
+        node->setInteger("height"_s, rect.height());
+        nodes->pushObject(WTF::move(node));
+        auto children = object->unignoredChildren();
+        for (auto iterator = children.rbegin(); iterator != children.rend(); ++iterator)
+            pending.append({ iterator->copyRef(), id });
+    }
+    result->setArray("nodes"_s, WTF::move(nodes));
+    callback(result->toJSONString());
+}
+
+void WebPage::hostAccessibilityAction(const String& token, uint64_t id, uint32_t action, const String& value, CompletionHandler<void(bool)>&& callback)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!document || document->identifier().toString() != token || !AXID::isValidIdentifier(id)) {
+        callback(false);
+        return;
+    }
+    auto* cache = document->axObjectCache();
+    RefPtr object = cache ? cache->objectForID(AXID { id }) : nullptr;
+    if (!object || !object->isEnabled()) {
+        callback(false);
+        return;
+    }
+    if (action == 0 && object->canSetFocusAttribute()) {
+        object->setFocused(true);
+        callback(true);
+    } else if (action == 1)
+        callback(object->press());
+    else if (action == 2 && object->canSetValueAttribute())
+        callback(object->setValue(value));
+    else
+        callback(false);
+}
