+unsigned WKViewGetHostDesktopAPIVersion(void)
+{
+    return 1;
+}
+
+bool WKViewSetHostDesktopGeometry(WKViewRef viewRef, HWND target, int degrees, int offsetX, int offsetY)
+{
+    if (!viewRef || (target && !IsWindow(target)) || (degrees != 0 && degrees != 90 && degrees != 180 && degrees != 270))
+        return false;
+    auto window = toImpl(viewRef)->window();
+    if (!target) {
+        for (auto key : { hostTargetProperty, hostTurnProperty, hostXProperty, hostYProperty })
+            RemovePropW(window, key);
+        return true;
+    }
+    bool updated = SetPropW(window, hostTargetProperty, target)
+        && SetPropW(window, hostTurnProperty, reinterpret_cast<HANDLE>(static_cast<INT_PTR>(degrees)))
+        && SetPropW(window, hostXProperty, reinterpret_cast<HANDLE>(static_cast<INT_PTR>(offsetX)))
+        && SetPropW(window, hostYProperty, reinterpret_cast<HANDLE>(static_cast<INT_PTR>(offsetY)));
+    if (auto* page = toImpl(viewRef)->page(); updated && GetFocus() == window && page && !page->isClosed())
+        hostUpdateCaret(window, *page);
+    return updated;
+}
+
+WKStringRef WKViewCopyHostAccessibilityTree(WKViewRef viewRef)
+{
+    if (!viewRef)
+        return nullptr;
+    auto* page = toImpl(viewRef)->page();
+    if (!page || page->isClosed() || !page->hasRunningProcess())
+        return nullptr;
+    auto reply = page->legacyMainFrameProcess().sendSync(Messages::WebPage::GetHostAccessibilityTree(),
+        page->webPageIDInMainFrameProcess(), 1_s, IPC::SendSyncOption::MaintainOrderingWithAsyncMessages);
+    if (!reply.succeeded())
+        return nullptr;
+    auto [tree] = reply.takeReply();
+    return toAPILeakingRef(API::String::create(tree));
+}
+
+bool WKViewPerformHostAccessibilityAction(WKViewRef viewRef, WKStringRef document, unsigned long long objectID, unsigned action, WKStringRef value)
+{
+    if (!viewRef || !document || !objectID || action > 2)
+        return false;
+    auto* page = toImpl(viewRef)->page();
+    if (!page || page->isClosed() || !page->hasRunningProcess())
+        return false;
+    auto reply = page->legacyMainFrameProcess().sendSync(Messages::WebPage::HostAccessibilityAction(toImpl(document)->string(), objectID, action, toWTFString(value)),
+        page->webPageIDInMainFrameProcess(), 1_s, IPC::SendSyncOption::MaintainOrderingWithAsyncMessages);
+    return reply.succeeded() && std::get<0>(reply.reply());
+}
+
+void WKViewResetHostTextInput(WKViewRef viewRef)
+{
+    if (!viewRef) return;
+    auto* view = toImpl(viewRef);
+    auto window = view->window();
+    hostDeactivateTextStore(window);
+    for (auto key : { hostCaretProperty, hostCompositionProperty, L"DevDuo.WebKit.Editable", L"DevDuo.WebKit.Editor" })
+        RemovePropW(window, key);
+    if (auto context = ImmGetContext(window)) {
+        ImmNotifyIME(context, NI_COMPOSITIONSTR, CPS_CANCEL, 0);
+        ImmReleaseContext(window, context);
+    }
+    hostDestroyCaret(window);
+    if (GetFocus() == window && view->page() && !view->page()->isClosed()) hostUpdateCaret(window, *view->page());
+}
+
+WKStringRef WKViewCopyHostTextInputDiagnostics(WKViewRef view)
+{
+    return view ? toAPILeakingRef(API::String::create(hostTextInputDiagnostics(toImpl(view)->window()))) : nullptr;
+}
+
+unsigned WKViewGetHostTextInputState(WKViewRef viewRef, unsigned* error, unsigned long long* editor)
+{
+    if (error) *error = 0;
+    if (editor) *editor = 0;
+    if (!viewRef)
+        return 0;
+    return hostTextInputState(toImpl(viewRef)->window(), error, editor);
+}
