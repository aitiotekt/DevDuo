diff --git a/Source/WebKit/UIProcess/win/HostDesktopGeometry.h b/Source/WebKit/UIProcess/win/HostDesktopGeometry.h
new file mode 100644
index 000000000..69a3283b6
--- /dev/null
+++ b/Source/WebKit/UIProcess/win/HostDesktopGeometry.h
@@ -0,0 +1,70 @@
+// DevDuo host desktop coordinates. Physical source pixels are transformed only
+// for native OS surfaces; the WebCore layout viewport is never resized here.
+#pragma once
+
+#include <WebCore/IntRect.h>
+#include <algorithm>
+#include <windows.h>
+
+namespace WebKit {
+inline constexpr auto hostTargetProperty = L"DevDuo.WebKit.DesktopTarget";
+inline constexpr auto hostTurnProperty = L"DevDuo.WebKit.DesktopTurn";
+inline constexpr auto hostXProperty = L"DevDuo.WebKit.DesktopX";
+inline constexpr auto hostYProperty = L"DevDuo.WebKit.DesktopY";
+
+inline HWND hostPresentationWindow(HWND source)
+{
+    auto target = reinterpret_cast<HWND>(GetPropW(source, hostTargetProperty));
+    return target && IsWindow(target) ? target : source;
+}
+
+inline WebCore::IntRect hostClientToScreen(HWND source, const WebCore::IntRect& rect)
+{
+    auto target = reinterpret_cast<HWND>(GetPropW(source, hostTargetProperty));
+    POINT a { rect.x(), rect.y() }, b { rect.maxX(), rect.maxY() };
+    if (target && IsWindow(target)) {
+        RECT bounds { };
+        GetClientRect(source, &bounds);
+        auto turn = reinterpret_cast<INT_PTR>(GetPropW(source, hostTurnProperty));
+        auto transform = [&](POINT point) -> POINT {
+            switch (turn) {
+            case 90: return { bounds.bottom - point.y, point.x };
+            case 180: return { bounds.right - point.x, bounds.bottom - point.y };
+            case 270: return { point.y, bounds.right - point.x };
+            default: return point;
+            }
+        };
+        a = transform(a);
+        b = transform(b);
+        auto x = static_cast<LONG>(reinterpret_cast<INT_PTR>(GetPropW(source, hostXProperty)));
+        auto y = static_cast<LONG>(reinterpret_cast<INT_PTR>(GetPropW(source, hostYProperty)));
+        a.x -= x; b.x -= x;
+        a.y -= y; b.y -= y;
+    } else
+        target = source;
+    ClientToScreen(target, &a);
+    ClientToScreen(target, &b);
+    return { std::min(a.x, b.x), std::min(a.y, b.y), std::abs(b.x - a.x), std::abs(b.y - a.y) };
+}
+
+inline WebCore::IntPoint hostScreenToClient(HWND source, const WebCore::IntPoint& screen)
+{
+    auto target = reinterpret_cast<HWND>(GetPropW(source, hostTargetProperty));
+    POINT point { screen.x(), screen.y() };
+    if (!target || !IsWindow(target)) {
+        ScreenToClient(source, &point);
+        return point;
+    }
+    ScreenToClient(target, &point);
+    point.x += static_cast<LONG>(reinterpret_cast<INT_PTR>(GetPropW(source, hostXProperty)));
+    point.y += static_cast<LONG>(reinterpret_cast<INT_PTR>(GetPropW(source, hostYProperty)));
+    RECT bounds { };
+    GetClientRect(source, &bounds);
+    switch (reinterpret_cast<INT_PTR>(GetPropW(source, hostTurnProperty))) {
+    case 90: return { point.y, bounds.bottom - point.x };
+    case 180: return { bounds.right - point.x, bounds.bottom - point.y };
+    case 270: return { bounds.right - point.y, point.x };
+    default: return point;
+    }
+}
+} // namespace WebKit
diff --git a/Source/WebKit/UIProcess/win/HostInputMethodWin.h b/Source/WebKit/UIProcess/win/HostInputMethodWin.h
new file mode 100644
index 000000000..7aecb9976
--- /dev/null
+++ b/Source/WebKit/UIProcess/win/HostInputMethodWin.h
@@ -0,0 +1,194 @@
+// Native input composition uses ordinary production WebPage IPC and WebCore Editor.
+#pragma once
+
+#include "HostDesktopGeometry.h"
+#include "WebPageProxy.h"
+#include "MessageSenderInlines.h"
+#include "WebPageMessages.h"
+#include "WebProcessProxy.h"
+#include <imm.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+void hostActivateTextStore(HWND, WebPageProxy&);
+void hostDeactivateTextStore(HWND);
+String hostTextInputDiagnostics(HWND);
+void hostTextInputLayoutChanged(HWND, bool statusChanged);
+inline constexpr auto hostCompositionProperty = L"DevDuo.WebKit.Composition";
+inline constexpr auto hostCaretProperty = L"DevDuo.WebKit.CaretRequest";
+inline constexpr auto hostInputContextProperty = L"DevDuo.WebKit.InputContext";
+
+inline void hostInitializeInputMethod(HWND window)
+{
+    if (GetPropW(window, hostInputContextProperty))
+        return;
+    // Avalonia can disassociate its own default context when native children
+    // receive focus. This real editor owns an independent IMM context instead.
+    if (auto context = ImmCreateContext()) {
+        auto previous = ImmAssociateContext(window, context);
+        if (!SetPropW(window, hostInputContextProperty, context)) {
+            ImmAssociateContext(window, previous);
+            ImmDestroyContext(context);
+        }
+    }
+}
+
+
+inline void hostDestroyCaret(HWND window)
+{
+    GUITHREADINFO info { };
+    info.cbSize = sizeof(info);
+    if (GetGUIThreadInfo(GetCurrentThreadId(), &info) && info.hwndCaret == window)
+        DestroyCaret();
+}
+
+inline void hostUpdateCaret(HWND window, WebPageProxy& page)
+{
+    if (GetFocus() != window || page.isClosed())
+        return;
+    static uintptr_t nextRequest = 0;
+    auto request = ++nextRequest;
+    SetPropW(window, hostCaretProperty, reinterpret_cast<HANDLE>(request));
+    auto scale = page.intrinsicDeviceScaleFactor();
+    page.legacyMainFrameProcess().sendWithAsyncReply(Messages::WebPage::GetHostCaretRect(),
+        [window, request, scale, protectedPage = Ref { page }](bool editable, const WebCore::IntRect& logicalRect, uint64_t editor) {
+            if (protectedPage->isClosed() || !IsWindow(window) || GetFocus() != window || reinterpret_cast<uintptr_t>(GetPropW(window, hostCaretProperty)) != request)
+                return;
+            auto previousEditor = reinterpret_cast<uintptr_t>(GetPropW(window, L"DevDuo.WebKit.Editor"));
+            if (previousEditor != editor) hostDeactivateTextStore(window);
+            SetPropW(window, L"DevDuo.WebKit.Editor", reinterpret_cast<HANDLE>(static_cast<uintptr_t>(editor)));
+            bool changedStatus = !!GetPropW(window, L"DevDuo.WebKit.Editable") != editable;
+            SetPropW(window, L"DevDuo.WebKit.Editable", reinterpret_cast<HANDLE>(static_cast<INT_PTR>(editable)));
+            SetPropW(window, L"DevDuo.WebKit.CaretX", reinterpret_cast<HANDLE>(static_cast<INT_PTR>(logicalRect.x())));
+            SetPropW(window, L"DevDuo.WebKit.CaretY", reinterpret_cast<HANDLE>(static_cast<INT_PTR>(logicalRect.y())));
+            SetPropW(window, L"DevDuo.WebKit.CaretW", reinterpret_cast<HANDLE>(static_cast<INT_PTR>(logicalRect.width())));
+            SetPropW(window, L"DevDuo.WebKit.CaretH", reinterpret_cast<HANDLE>(static_cast<INT_PTR>(logicalRect.height())));
+            // Activate only after WebCore identifies a real editable selection.
+            // Some TIPs cache a disabled initial context despite status updates.
+            if (editable) hostActivateTextStore(window, protectedPage.get());
+            else hostDeactivateTextStore(window);
+            hostTextInputLayoutChanged(window, changedStatus);
+            if (!editable) {
+                hostDestroyCaret(window);
+                return;
+            }
+            WebCore::FloatRect scaled(logicalRect);
+            scaled.scale(scale);
+            auto rect = hostClientToScreen(window, WebCore::enclosingIntRect(scaled));
+            POINT a { rect.x(), rect.y() }, b { rect.maxX(), rect.maxY() };
+            ScreenToClient(window, &a);
+            ScreenToClient(window, &b);
+            if (auto context = ImmGetContext(window)) {
+                CANDIDATEFORM candidate { };
+                candidate.dwStyle = CFS_EXCLUDE;
+                candidate.ptCurrentPos = { a.x, b.y };
+                candidate.rcArea = { a.x, a.y, b.x, b.y };
+                ImmSetCandidateWindow(context, &candidate);
+                COMPOSITIONFORM composition { };
+                composition.dwStyle = CFS_POINT;
+                composition.ptCurrentPos = { a.x, b.y };
+                ImmSetCompositionWindow(context, &composition);
+                ImmReleaseContext(window, context);
+            }
+            // Keep an invisible OS caret for IMEs that use GUIThreadInfo rather
+            // than CANDIDATEFORM. WebCore remains the only visible caret painter.
+            CreateCaret(window, nullptr, std::max(1L, b.x - a.x), std::max(1L, b.y - a.y));
+            SetCaretPos(a.x, a.y);
+        }, page.webPageIDInMainFrameProcess());
+}
+
+inline void hostSendComposition(WebPageProxy& page, uint32_t operation, const String& text = { }, uint32_t cursor = 0, const Vector<uint8_t>& attributes = { })
+{
+    page.legacyMainFrameProcess().send(Messages::WebPage::HostSetComposition(operation, text, cursor, attributes), page.webPageIDInMainFrameProcess());
+}
+
+inline String hostCompositionString(HIMC context, DWORD kind)
+{
+    auto size = ImmGetCompositionStringW(context, kind, nullptr, 0);
+    if (size <= 0)
+        return emptyString();
+    Vector<char16_t> buffer(static_cast<size_t>(size) / sizeof(char16_t));
+    auto copied = ImmGetCompositionStringW(context, kind, buffer.mutableSpan().data(), size);
+    if (copied < 0)
+        return emptyString();
+    return String(buffer.span().first(static_cast<size_t>(copied) / sizeof(char16_t)));
+}
+
+bool hostTextStoreOwnsComposition(HWND);
+unsigned hostTextInputState(HWND, unsigned*, uint64_t*);
+
+inline bool hostHandleInputMethod(HWND window, WebPageProxy& page, UINT message, LPARAM lParam)
+{
+    if (message == WM_SETFOCUS)
+        hostInitializeInputMethod(window);
+    if (message == WM_APP + 0x3f) {
+        hostUpdateCaret(window, page);
+        return true;
+    }
+    if (message == WM_APP + 0x3e) {
+        hostActivateTextStore(window, page);
+        return true;
+    }
+    if (message == WM_KILLFOCUS || message == WM_NCDESTROY)
+        hostDeactivateTextStore(window);
+    if ((message == WM_IME_STARTCOMPOSITION || message == WM_IME_COMPOSITION || message == WM_IME_ENDCOMPOSITION)
+        && hostTextStoreOwnsComposition(window))
+        return true;
+    if (message == WM_NCDESTROY) {
+        RemovePropW(window, hostCaretProperty);
+        if (auto context = reinterpret_cast<HIMC>(RemovePropW(window, hostInputContextProperty))) {
+            ImmAssociateContext(window, nullptr);
+            ImmDestroyContext(context);
+        }
+        return false;
+    }
+    if (message == WM_IME_STARTCOMPOSITION) {
+        SetPropW(window, hostCompositionProperty, reinterpret_cast<HANDLE>(1));
+        hostSendComposition(page, 0);
+        hostUpdateCaret(window, page);
+        return true;
+    }
+    if (message == WM_IME_ENDCOMPOSITION || message == WM_KILLFOCUS) {
+        if (message == WM_KILLFOCUS) {
+            RemovePropW(window, hostCaretProperty);
+            hostDestroyCaret(window);
+        }
+        if (RemovePropW(window, hostCompositionProperty))
+            hostSendComposition(page, 3);
+        return message == WM_IME_ENDCOMPOSITION;
+    }
+    if (message != WM_IME_COMPOSITION)
+        return false;
+    auto context = ImmGetContext(window);
+    if (!context)
+        return false;
+    if (!GetPropW(window, hostCompositionProperty)) {
+        SetPropW(window, hostCompositionProperty, reinterpret_cast<HANDLE>(1));
+        hostSendComposition(page, 0);
+    }
+    if (lParam & GCS_RESULTSTR) {
+        hostSendComposition(page, 2, hostCompositionString(context, GCS_RESULTSTR));
+        RemovePropW(window, hostCompositionProperty);
+    }
+    if (lParam & GCS_COMPSTR) {
+        if (!GetPropW(window, hostCompositionProperty)) {
+            SetPropW(window, hostCompositionProperty, reinterpret_cast<HANDLE>(1));
+            hostSendComposition(page, 0);
+        }
+        Vector<uint8_t> attributes;
+        auto size = ImmGetCompositionStringW(context, GCS_COMPATTR, nullptr, 0);
+        if (size > 0) {
+            attributes.resize(size);
+            ImmGetCompositionStringW(context, GCS_COMPATTR, attributes.mutableSpan().data(), size);
+        }
+        auto cursor = ImmGetCompositionStringW(context, GCS_CURSORPOS, nullptr, 0);
+        hostSendComposition(page, 1, hostCompositionString(context, GCS_COMPSTR), std::max(0L, cursor), attributes);
+    } else if (!lParam) {
+        hostSendComposition(page, 3);
+        RemovePropW(window, hostCompositionProperty);
+    }
+    ImmReleaseContext(window, context);
+    hostUpdateCaret(window, page);
+    return true;
+}
+} // namespace WebKit
