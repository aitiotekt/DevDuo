+        publishComposition(); return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetFormattedText(LONG, LONG, IDataObject** data) override { if (data) *data = nullptr; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE GetEmbedded(LONG, REFGUID, REFIID, IUnknown** object) override { if (object) *object = nullptr; return TS_E_FORMAT; }
+    HRESULT STDMETHODCALLTYPE QueryInsertEmbedded(const GUID*, const FORMATETC*, BOOL* insertable) override { if (!insertable) return E_POINTER; *insertable = FALSE; return S_OK; }
+    HRESULT STDMETHODCALLTYPE InsertEmbedded(DWORD, LONG, LONG, IDataObject*, TS_TEXTCHANGE*) override { return TS_E_FORMAT; }
