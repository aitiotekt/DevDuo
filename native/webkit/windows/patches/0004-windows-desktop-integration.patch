+        }
+        m_dirty = false;
+        if (!m_reset) return;
+        trace(L"reset", m_text.size());
+        m_reset = false;
+        LONG previousLength = static_cast<LONG>(m_text.size());
+        m_text.clear(); m_start = m_end = 0;
+        auto sink = m_sink;
+        if (sink && (m_sinkMask & TS_AS_TEXT_CHANGE) && previousLength) {
+            TS_TEXTCHANGE change { 0, previousLength, 0 };
+            sink->OnTextChange(0, &change);
+        }
+        if (sink && (m_sinkMask & TS_AS_SEL_CHANGE)) sink->OnSelectionChange();
+        if (!m_page->isClosed()) hostUpdateCaret(m_window, m_page.get());
+    }
+    static LRESULT CALLBACK messageHook(int code, WPARAM removed, LPARAM data)
+    {
+        auto* store = s_active;
+        if (code >= 0 && removed == PM_REMOVE && store && !store->m_closing) {
+            auto& message = *reinterpret_cast<MSG*>(data);
+            if (message.hwnd == store->m_window && GetFocus() == store->m_window
+                && (message.message == WM_KEYDOWN || message.message == WM_KEYUP)) {
+                store->AddRef();
+                ComPtr<ITfDocumentMgr> focused;
+                store->m_thread->GetFocus(&focused);
+                if (focused.Get() != store->m_document.Get())
+                    store->m_thread->SetFocus(store->m_document.Get());
+                auto key = message.wParam == VK_PROCESSKEY ? ImmGetVirtualKey(message.hwnd) : message.wParam;
+                BOOL eaten = FALSE;
+                bool down = message.message == WM_KEYDOWN;
+                HRESULT result = down ? store->m_keys->TestKeyDown(key, message.lParam, &eaten) : store->m_keys->TestKeyUp(key, message.lParam, &eaten);
+                if (SUCCEEDED(result) && eaten)
+                    result = down ? store->m_keys->KeyDown(key, message.lParam, &eaten) : store->m_keys->KeyUp(key, message.lParam, &eaten);
+                if (SUCCEEDED(result) && eaten && !store->m_closing && !store->m_page->isClosed()) {
+                    store->m_handledKey = true;
+                    store->m_page->handleKeyboardEvent(NativeWebKeyboardEvent::create(message.hwnd, message.message, VK_PROCESSKEY, message.lParam, { }));
+                    message.message = WM_NULL;
+                } else if (down && !store->m_composing)
+                    store->m_handledKey = false;
+                store->Release();
+            }
+        }
+        return CallNextHookEx(nullptr, code, removed, data);
+    }
+    static thread_local HostTextStore* s_active;
+    std::atomic<ULONG> m_references { 1 };
+    HWND m_window;
+    Ref<WebPageProxy> m_page;
+    ComPtr<ITfThreadMgr> m_thread;
+    ComPtr<ITfKeystrokeMgr> m_keys;
+    ComPtr<ITfConfigureSystemKeystrokeFeed> m_feed;
+    bool m_feedDisabled { false };
+    ComPtr<ITfDocumentMgr> m_document, m_previousAssociation, m_previousFocus;
+    ComPtr<ITfContext> m_context;
+    ComPtr<ITfSource> m_editSource;
+    DWORD m_editCookie { TF_INVALID_COOKIE };
+    ComPtr<ITextStoreACPSink> m_sink;
+    TfClientId m_client { 0 };
+    HHOOK m_hook { nullptr };
+    DWORD m_lock { 0 }, m_pendingLock { 0 }, m_sinkMask { 0 };
+    bool m_comInitialized { false }, m_layoutPending { false }, m_statusPending { false };
+    bool m_activated { false }, m_associated { false }, m_closing { false }, m_composing { false }, m_dirty { false }, m_reset { false }, m_handledKey { false };
+    LONG m_start { 0 }, m_end { 0 }, m_lastCursor { -1 };
+    std::wstring m_text, m_lastText, m_trace;
+};
+thread_local HostTextStore* HostTextStore::s_active;
+
+void hostActivateTextStore(HWND window, WebPageProxy& page)
+{
+    if (auto* store = reinterpret_cast<HostTextStore*>(GetPropW(window, storeProperty))) { store->grantPendingLock(); return; }
+    if (GetFocus() != window || page.isClosed() || !GetPropW(window, L"DevDuo.WebKit.Editable")) return;
+    auto* store = new HostTextStore(window, page);
+    auto result = store->activate();
+    SetPropW(window, errorProperty, reinterpret_cast<HANDLE>(static_cast<INT_PTR>(result)));
+    if (FAILED(result) || !SetPropW(window, storeProperty, store)) { store->deactivate(); store->Release(); }
+}
+void hostTextInputLayoutChanged(HWND window, bool statusChanged)
+{
+    if (auto* store = reinterpret_cast<HostTextStore*>(GetPropW(window, storeProperty))) store->layoutChanged(statusChanged);
+}
+void hostDeactivateTextStore(HWND window)
+{
+    if (auto* store = reinterpret_cast<HostTextStore*>(RemovePropW(window, storeProperty))) { store->deactivate(); store->Release(); }
+}
+bool hostTextStoreOwnsComposition(HWND window)
+{
+    auto* store = reinterpret_cast<HostTextStore*>(GetPropW(window, storeProperty));
+    return store && store->ownsComposition();
+}
+String hostTextInputDiagnostics(HWND window)
+{
+    auto* store = reinterpret_cast<HostTextStore*>(GetPropW(window, storeProperty));
+    return store ? store->diagnostics() : emptyString();
+}
+unsigned hostTextInputState(HWND window, unsigned* error, uint64_t* editor)
+{
+    if (editor) *editor = reinterpret_cast<uintptr_t>(GetPropW(window, L"DevDuo.WebKit.Editor"));
+    if (error) *error = static_cast<unsigned>(reinterpret_cast<INT_PTR>(GetPropW(window, errorProperty)));
+    auto* store = reinterpret_cast<HostTextStore*>(GetPropW(window, storeProperty));
+    return (store ? store->state() : 0) | (GetPropW(window, L"DevDuo.WebKit.Editable") ? 16u : 0u);
+}
+} // namespace WebKit
