+void WKViewRequestFixedContainerColorsV2(WKViewRef viewRef, unsigned long long requestID, const void* context, WKFixedContainerColorCallbackV2 callback)
+{
+    if (!callback) return;
+    auto* page = viewRef ? toImpl(viewRef)->page() : nullptr;
+    if (!page || page->isClosed()) { callback(requestID, 1, 0, 0xff, 0, 0, 0, 0, 0, context); return; }
+    page->getHostFixedContainerColorsV2([requestID, context, callback](uint32_t status, uint64_t epoch, uint32_t states, uint32_t reasons, uint32_t top, uint32_t right, uint32_t bottom, uint32_t left) {
+        callback(requestID, status, epoch, states, reasons, top, right, bottom, left, context);
+    });
 }
 
