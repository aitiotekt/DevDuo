 }
+void WebPage::getHostFixedContainerColorsV2(CompletionHandler<void(uint32_t, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t)>&& callback)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr view = frame ? frame->view() : nullptr;
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!view || !document) {
+        callback(1, 0, 0xff, 0, 0, 0, 0, 0);
+        return;
+    }
+    view->updateLayoutAndStyleIfNeededRecursive();
+    auto [edges, elements] = view->fixedContainerEdges({ BoxSide::Top, BoxSide::Right, BoxSide::Bottom, BoxSide::Left }, true);
+    uint32_t states = 0, reasons = 0;
+    auto sample = [&](BoxSide side, unsigned index) -> uint32_t {
+        if (!elements.at(side))
+            return 0;
+        const auto& coverage = edges.colors.at(side);
+        if (std::holds_alternative<PredominantColorType>(coverage)
+            && std::get<PredominantColorType>(coverage) == PredominantColorType::Multiple) {
+            states |= 2u << (index * 2);
+            reasons |= 2u << (index * 4); // Inconsistent coverage.
+            return 0;
+        }
+        auto color = edges.predominantColor(side);
+        if (!color.isValid() || !color.isOpaque()) {
+            states |= 2u << (index * 2);
+            reasons |= 2u << (index * 4);
+            return 0;
+        }
+        states |= 1u << (index * 2);
+        reasons |= 4u << (index * 4); // Native background or fixed/sticky predominant color.
+        auto [r, g, b, a] = color.toColorTypeLossy<SRGBA<uint8_t>>().resolved();
+        return (static_cast<uint32_t>(r) << 16) | (static_cast<uint32_t>(g) << 8) | b;
+    };
+    auto top = sample(BoxSide::Top, 0), right = sample(BoxSide::Right, 1);
+    auto bottom = sample(BoxSide::Bottom, 2), left = sample(BoxSide::Left, 3);
+    callback(0, WebCore::hostScrollIndicatorState(*view).documentEpoch, states, reasons, top, right, bottom, left);
+}
