 #if PLATFORM(WIN)
+HostFrameEdges WebPage::hostFrameEdges()
+{
+    HostFrameEdges result;
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr view = frame ? frame->view() : nullptr;
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!view || !document)
+        return result;
+    // The caller has finalized layout for this very frame. Sampling only reads
+    // WebCore's fixed-container semantics and never changes the layout viewport.
+    getHostFixedContainerColorsV2([&](uint32_t status, uint64_t epoch, uint32_t states, uint32_t reasons,
+        uint32_t top, uint32_t right, uint32_t bottom, uint32_t left) {
+        result.documentEpoch = epoch;
+        result.states = status ? 0xff : states;
+        result.reasons = reasons;
+        result.top = top; result.right = right; result.bottom = bottom; result.left = left;
+    });
+    const auto& insets = corePage()->obscuredContentInsets();
+    result.insetTop = insets.top(); result.insetRight = insets.right();
+    result.insetBottom = insets.bottom(); result.insetLeft = insets.left();
+    auto position = view->scrollPosition();
+    auto extent = view->contentsSize();
+    const auto viewportWidth = size().width() - insets.left() - insets.right();
+    const auto viewportHeight = size().height() - insets.top() - insets.bottom();
+    result.flowLeft = std::lround(insets.left() - std::clamp<float>(position.x(), 0, insets.left()));
+    result.flowTop = std::lround(insets.top() - std::clamp<float>(position.y(), 0, insets.top()));
+    result.flowRight = std::lround(insets.left() + viewportWidth + std::clamp<float>(extent.width() - position.x() - viewportWidth, 0, insets.right()));
+    result.flowBottom = std::lround(insets.top() + viewportHeight + std::clamp<float>(extent.height() - position.y() - viewportHeight, 0, insets.bottom()));
+    // Match the opaque html/body fallback, independently of theme-color and
+    // fixed-container materials, without an observer round trip.
+    Color background = Color::white;
+    for (RefPtr<Element> element : std::array<RefPtr<Element>, 2> { document->documentElement(), document->body() }) {
+        if (!element || !element->computedStyle()) continue;
+        auto color = element->computedStyle()->visitedDependentUsedBackgroundColorApplyingColorFilter();
+        if (color.isOpaque()) { background = color; break; }
+    }
+    auto [r, g, b, a] = background.toColorTypeLossy<SRGBA<uint8_t>>().resolved();
+    result.root = (static_cast<uint32_t>(r) << 16) | (static_cast<uint32_t>(g) << 8) | b;
+    return result;
+}
