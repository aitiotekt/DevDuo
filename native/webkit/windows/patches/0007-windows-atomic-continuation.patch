+bool WKViewGetHostFrameClock(double* nativeSeconds, double* qpcSeconds, double* uncertaintySeconds)
+{
+    if (!nativeSeconds || !qpcSeconds || !uncertaintySeconds) return false;
+    LARGE_INTEGER before, after, frequency;
+    if (!QueryPerformanceFrequency(&frequency) || !QueryPerformanceCounter(&before)) return false;
+    *nativeSeconds = MonotonicTime::now().secondsSinceEpoch().value();
+    if (!QueryPerformanceCounter(&after)) return false;
+    *qpcSeconds = (before.QuadPart / 2.0 + after.QuadPart / 2.0) / frequency.QuadPart;
+    *uncertaintySeconds = static_cast<double>(after.QuadPart - before.QuadPart) / frequency.QuadPart;
+    return true;
 }
 
