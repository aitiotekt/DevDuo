+bool WKViewCopyHostFrameEdges(WKViewRef viewRef, WKHostFrameEdges* output)
+{
+    if (!viewRef || !output) return false;
+    auto* page = toImpl(viewRef)->page();
+    if (!page || page->isClosed() || !page->drawingArea()) return false;
+    const auto& edges = static_cast<DrawingAreaProxyWC*>(page->drawingArea())->hostPaintedEdges();
+    output->frameID = edges.frameID;
+    output->documentEpoch = edges.documentEpoch;
+    output->states = edges.states;
+    output->reasons = edges.reasons;
+    output->colorMask = edges.colorMask;
+    output->top = edges.top;
+    output->right = edges.right;
+    output->bottom = edges.bottom;
+    output->left = edges.left;
+    output->root = edges.root;
+    output->insetTop = edges.insetTop;
+    output->insetRight = edges.insetRight;
+    output->insetBottom = edges.insetBottom;
+    output->insetLeft = edges.insetLeft;
+    output->flowLeft = edges.flowLeft;
+    output->flowTop = edges.flowTop;
+    output->flowRight = edges.flowRight;
+    output->flowBottom = edges.flowBottom;
+    return edges.frameID != 0;
+}
