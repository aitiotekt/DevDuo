+#if PLATFORM(WIN)
+void DrawingAreaProxyWC::hostEdgeExpiryTimerFired()
+{
+    const auto now = MonotonicTime::now().secondsSinceEpoch().value();
+    bool changed = false;
+    double deadline = 0;
+    for (unsigned side = 0; side < 4; ++side) {
+        auto& expiry = m_hostEdgeDeadlines[side];
+        if (expiry && expiry <= now) {
+            m_hostEdges.colorMask &= ~(1u << side);
+            expiry = 0;
+            changed = true;
+        } else if (expiry && (!deadline || expiry < deadline)) deadline = expiry;
+    }
+    if (changed && page() && m_backingStore)
+        page()->setViewNeedsDisplay(WebCore::Region(WebCore::IntRect({ }, m_backingStore->size())));
+    if (deadline) m_hostEdgeExpiryTimer.startOneShot(Seconds(deadline - now));
+}
+#endif
