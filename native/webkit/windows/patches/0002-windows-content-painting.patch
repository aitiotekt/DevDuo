+bool WKViewGetHostRenderingStatistics(WKViewRef viewRef, unsigned long long* updates,
+    unsigned long long* acceleratedTransitions, unsigned long long* staleUpdates)
+{
+#if USE(GRAPHICS_LAYER_WC)
+    if (!viewRef || !updates || !acceleratedTransitions || !staleUpdates)
+        return false;
+    auto* view = toImpl(viewRef);
+    if (!view->page() || view->page()->isClosed() || !view->page()->drawingArea())
+        return false;
+    auto* area = static_cast<DrawingAreaProxyWC*>(view->page()->drawingArea());
+    *updates = area->hostUpdateCount();
+    *acceleratedTransitions = area->hostAcceleratedTransitionCount();
+    *staleUpdates = area->hostStaleUpdateCount();
+    return true;
+#else
+    return false;
+#endif
+}
