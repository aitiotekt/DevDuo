+#if PLATFORM(WIN)
+static IntSize tileRasterSize(const FloatSize& size, float scale)
+{
+    if (size.isEmpty())
+        return { };
+    // The CSS background painter snaps local edges at this device scale.
+    // Excluding the unsnapped padding keeps the last texel from mixing
+    // transparent backing pixels into an otherwise covered layer edge.
+    auto rasterSize = roundedIntSize(size * scale);
+    rasterSize.clampToMinimumSize({ 1, 1 });
+    return rasterSize;
+}
+#endif
 
