+            item.scrollX, item.scrollY, item.inputEventSeconds, item.inputDispatchSeconds, item.commitSeconds,
+            item.gpuStartSeconds, item.gpuEndSeconds, item.receiveSeconds, item.paintStartSeconds, item.paintEndSeconds };
