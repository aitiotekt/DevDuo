 void RemoteWCLayerTreeHostProxy::update(WCUpdateInfo&& updateInfo, CompletionHandler<void(std::optional<WebKit::UpdateInfo>)>&& completionHandler)
 {
+#if PLATFORM(WIN) && ENABLE(ASYNC_SCROLLING)
+    auto revision = updateInfo.hostScrollRevision;
+    sendWithAsyncReply(Messages::RemoteWCLayerTreeHost::Update(updateInfo),
+        [scene = m_scrollingScene, revision, completionHandler = WTF::move(completionHandler)](std::optional<UpdateInfo> result) mutable {
+            if (RefPtr liveScene = scene.get()) liveScene->didCompleteComposition(revision);
+            completionHandler(WTF::move(result));
+        });
+#else
     sendWithAsyncReply(Messages::RemoteWCLayerTreeHost::Update(updateInfo), WTF::move(completionHandler));
+#endif
 }
+
+#if PLATFORM(WIN) && ENABLE(ASYNC_SCROLLING)
+void RemoteWCLayerTreeHostProxy::bindScrollingScene(WebCore::ScrollingSceneWC& scene, uint64_t epoch, uint64_t stateID)
+{
+    ASSERT(isMainRunLoop());
+    m_scrollingScene = scene;
+    Ref connection = ensureGPUProcessConnection().connection();
+    scene.setPublisher([connection = WTF::move(connection), destination = messageSenderDestinationID(), epoch, stateID,
+        weakScene = ThreadSafeWeakPtr { scene }, replies = m_scrollReplies.copyRef()](WebCore::WCScrollUpdate&& update) mutable {
+        connection->sendWithAsyncReplyOnDispatcher(Messages::RemoteWCLayerTreeHost::UpdateScroll(epoch, stateID, WTF::move(update)), replies.get(),
+            [weakScene](uint64_t completedRevision) {
+                if (RefPtr scene = weakScene.get()) scene->didCompleteComposition(completedRevision);
+            }, destination);
+    });
+}
+#endif
 
 } // namespace WebKit
 
