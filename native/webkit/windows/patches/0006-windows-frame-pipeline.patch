+
+unsigned WKViewCopyHostFrameTimings(WKViewRef viewRef, WKHostFrameTiming* output, unsigned capacity)
+{
+    if (!viewRef || !output || !capacity)
+        return 0;
+    auto* page = toImpl(viewRef)->page();
+    if (!page || page->isClosed() || !page->drawingArea())
+        return 0;
+    const auto& history = static_cast<DrawingAreaProxyWC*>(page->drawingArea())->hostPaintTimings();
+    auto count = std::min(capacity, static_cast<unsigned>(history.size()));
+    auto offset = history.size() - count;
+    for (unsigned index = 0; index < count; ++index) {
+        const auto& item = history[offset + index];
+        output[index].frameID = item.frameID;
+        output[index].inputSequence = item.inputSequence;
+        output[index].inputEventSeconds = item.inputEventSeconds;
+        output[index].inputDispatchSeconds = item.inputDispatchSeconds;
+        output[index].renderStartSeconds = item.renderStartSeconds;
+        output[index].renderEndSeconds = item.renderEndSeconds;
+        output[index].commitSeconds = item.commitSeconds;
+        output[index].gpuStartSeconds = item.gpuStartSeconds;
+        output[index].gpuEndSeconds = item.gpuEndSeconds;
+        output[index].receiveSeconds = item.receiveSeconds;
+        output[index].paintStartSeconds = item.paintStartSeconds;
+        output[index].paintEndSeconds = item.paintEndSeconds;
+    }
+    return count;
 }
 
