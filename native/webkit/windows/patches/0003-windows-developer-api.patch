new file mode 100644
--- /dev/null
+++ b/Source/WebKit/UIProcess/win/HostProcessCapabilityTransfer.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#if PLATFORM(WIN)
+#include <atomic>
+#include <cstdlib>
+#include <type_traits>
+#include <wtf/Noncopyable.h>
+#include <wtf/RefPtr.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/win/Win32Handle.h>
+
+namespace WebKit {
+
+// A pushed value belongs to the exact child process before IPC delivery. If the
+// handler never acknowledges adoption, ending that process releases the value.
+// Never reclaim a remote numeric HANDLE: the child may have already reused it.
+class HostProcessCapabilityTransfer : public ThreadSafeRefCounted<HostProcessCapabilityTransfer> {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(HostProcessCapabilityTransfer);
+    WTF_MAKE_NONCOPYABLE(HostProcessCapabilityTransfer);
+public:
+    static RefPtr<HostProcessCapabilityTransfer> push(HANDLE sourceCapability, Win32Handle&& targetProcess)
+    {
+        if (!isRealHandle(sourceCapability) || !isRealHandle(targetProcess.get()))
+            return nullptr;
+        HANDLE remote = nullptr;
+        if (!::DuplicateHandle(GetCurrentProcess(), sourceCapability, targetProcess.get(), &remote, 0, FALSE, DUPLICATE_SAME_ACCESS))
+            return nullptr;
+        return adoptRef(*new HostProcessCapabilityTransfer(WTF::move(targetProcess), remote));
+    }
+    ~HostProcessCapabilityTransfer()
+    {
+        if (!m_processed.load())
+            terminateTarget();
+    }
+    uint64_t remoteHandle() const { return reinterpret_cast<uint64_t>(m_remoteHandle); }
+    void didProcess() { m_processed = true; }
+    void terminateTarget() const
+    {
+        // Win32Handle's moved-from value is -1, which is also the current-process
+        // pseudo handle. The guard itself is never moved and rejects every pseudo.
+        if (isRealHandle(m_targetProcess.get()))
+            ::TerminateProcess(m_targetProcess.get(), EXIT_FAILURE);
+    }
+private:
+    static bool isRealHandle(HANDLE handle)
+    {
+        auto value = reinterpret_cast<intptr_t>(handle);
+        return value && (value > 0 || value < -12);
+    }
+    HostProcessCapabilityTransfer(Win32Handle&& targetProcess, HANDLE remoteHandle)
+        : m_targetProcess(WTF::move(targetProcess))
+        , m_remoteHandle(remoteHandle)
+    {
+    }
+    Win32Handle m_targetProcess;
+    HANDLE m_remoteHandle;
+    std::atomic<bool> m_processed { false };
+};
+static_assert(!std::is_copy_constructible_v<HostProcessCapabilityTransfer>);
+static_assert(!std::is_move_constructible_v<HostProcessCapabilityTransfer>);
+
+} // namespace WebKit
+#endif

