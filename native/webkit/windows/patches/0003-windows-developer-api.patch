+#include <wtf/Locker.h>
+#include <wtf/NeverDestroyed.h>
 
 namespace WTF {
+
+static bool isRealHandle(HANDLE handle)
+{
+    auto value = reinterpret_cast<intptr_t>(handle);
+    return value && (value > 0 || value < -12);
+}
+
+struct SourceCapability : ThreadSafeRefCounted<SourceCapability> {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(SourceCapability);
+public:
+    explicit SourceCapability(Win32Handle&& sourceHandle)
+        : handle(WTF::move(sourceHandle))
+    {
+    }
+
+    Win32Handle handle;
+    unsigned connections { 1 };
+};
+
+static Lock& sourceCapabilityLock()
+{
+    static NeverDestroyed<Lock> lock;
+    return lock;
+}
+
+static HashMap<DWORD, Ref<SourceCapability>>& sourceCapabilities()
+{
+    static NeverDestroyed<HashMap<DWORD, Ref<SourceCapability>>> sources;
+    return sources;
+}
+
+Win32HandleSource::Win32HandleSource(DWORD processID, Win32Handle&& handle)
+{
+    DWORD flags = 0;
+    if (!processID || !isRealHandle(handle.get()) || !::GetHandleInformation(handle.get(), &flags))
+        return;
+    Locker locker { sourceCapabilityLock() };
+    auto entry = sourceCapabilities().find(processID);
+    if (entry != sourceCapabilities().end())
+        ++entry->value->connections;
+    else
+        sourceCapabilities().add(processID, adoptRef(*new SourceCapability(WTF::move(handle))));
+    m_processID = processID;
+}
+
+Win32HandleSource::~Win32HandleSource()
+{
+    if (!m_processID)
+        return;
+    Locker locker { sourceCapabilityLock() };
+    auto entry = sourceCapabilities().find(m_processID);
+    RELEASE_ASSERT(entry != sourceCapabilities().end());
+    if (!--entry->value->connections)
+        sourceCapabilities().remove(entry);
+}
+
+static RefPtr<SourceCapability> copySourceCapability(DWORD processID)
+{
+    Locker locker { sourceCapabilityLock() };
+    auto entry = sourceCapabilities().find(processID);
+    if (entry == sourceCapabilities().end())
+        return { };
+    // Retain the capability under the lock. An in-flight decoder keeps its
+    // HANDLE alive after the last connection unregisters, without another
+    // potentially expensive kernel operation on a process handle.
+    return entry->value.ptr();
+}
