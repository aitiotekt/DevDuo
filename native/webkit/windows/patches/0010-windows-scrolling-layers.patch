+
+namespace WebCore {
+WTF_MAKE_TZONE_ALLOCATED_IMPL(ScrollingLayerWC);
+WTF_MAKE_TZONE_ALLOCATED_IMPL(ScrollingSceneWC);
+
+ScrollingLayerWC::~ScrollingLayerWC()
+{
+    m_scene->removeLayer(m_identifier);
+}
+void ScrollingLayerWC::synchronize(const GraphicsLayer& layer)
+{
+    ASSERT(isMainThread());
+    Vector<Ref<ScrollingLayerWC>> children;
+    for (auto& child : layer.children()) {
+        if (auto* scrolling = child->scrollingLayerWC()) children.append(*scrolling);
+    }
+    Vector<Ref<ScrollingLayerWC>> oldChildren;
+    {
+        Locker locker { m_lock };
+        oldChildren = std::exchange(m_children, WTF::move(children));
+        m_pendingPosition = layer.position();
+        m_pendingBoundsOrigin = layer.boundsOrigin();
+        m_anchorPoint = layer.anchorPoint(); m_size = layer.size();
+        m_transform = layer.transform(); m_masksToBounds = layer.masksToBounds();
+        m_eventRegion = layer.eventRegion(); m_scrollingNodeID = layer.scrollingNodeID();
+        m_mask = layer.maskLayer() ? layer.maskLayer()->scrollingLayerWC() : nullptr;
+        children = m_children;
+    }
+    for (auto& child : oldChildren) {
+        Locker locker { child->m_lock };
+        if (child->m_parent.get().get() == this) child->m_parent = nullptr;
+    }
+    for (auto& child : children) {
+        Locker locker { child->m_lock };
+        child->m_parent = *this;
+    }
+}
+void ScrollingLayerWC::setPositionForScrolling(const FloatPoint& position)
+{
+    Locker locker { m_lock }; m_scrollingPosition = position;
+}
+void ScrollingLayerWC::setBoundsOriginForScrolling(const FloatPoint& origin)
+{
+    Locker locker { m_lock }; m_scrollingBoundsOrigin = origin;
+}
+void ScrollingLayerWC::setTopLeftPositionForScrolling(const FloatPoint& position)
+{
+    Locker locker { m_lock };
+    m_scrollingPosition = { position.x() + m_anchorPoint.x() * m_size.width(), position.y() + m_anchorPoint.y() * m_size.height() };
+}
+FloatPoint ScrollingLayerWC::topLeftPositionForScrolling()
+{
+    Locker locker { m_lock };
+    return m_position - toFloatSize(m_anchorPoint.xy()) * m_size;
+}
+std::optional<WCScrollLayerPosition> ScrollingLayerWC::takePositionUpdate()
+{
+    Locker locker { m_lock };
+    WCScrollLayerPosition result { m_identifier };
+    // Match coordinated graphics: an asynchronous position takes priority over
+    // the main thread's older pending value. Do not add deltas twice.
+    auto position = m_scrollingPosition ? std::exchange(m_scrollingPosition, std::nullopt) : m_pendingPosition;
+    auto origin = m_scrollingBoundsOrigin ? std::exchange(m_scrollingBoundsOrigin, std::nullopt) : m_pendingBoundsOrigin;
+    m_pendingPosition = m_pendingBoundsOrigin = std::nullopt;
+    if (position && *position != m_position) { m_position = *position; result.changed |= 1; }
+    if (origin && *origin != m_boundsOrigin) { m_boundsOrigin = *origin; result.changed |= 2; }
+    result.position = m_position; result.boundsOrigin = m_boundsOrigin;
+    return result.changed ? std::optional { result } : std::nullopt;
+}
+void ScrollingSceneWC::addLayer(ScrollingLayerWC& layer)
+{
+    Locker locker { m_lock }; m_layers.set(layer.identifier(), ThreadSafeWeakPtr<ScrollingLayerWC> { layer });
+}
+void ScrollingSceneWC::removeLayer(PlatformLayerIdentifier identifier)
+{
+    Locker locker { m_lock };
+    m_layers.remove(identifier);
+}
+void ScrollingSceneWC::setPublisher(Publisher&& publisher)
+{
+    Locker locker { m_lock }; m_publisher = WTF::move(publisher);
+}
+uint64_t ScrollingSceneWC::revision() const
+{
+    Locker locker { m_lock }; return m_revision;
+}
+bool ScrollingSceneWC::isCompositionRequiredOrOngoing() const
+{
+    Locker locker { m_lock };
+    return m_publishedRevision > m_completedRevision;
+}
+void ScrollingSceneWC::didCompleteComposition(uint64_t revision)
+{
+    Locker locker { m_lock };
+    m_completedRevision = std::max(m_completedRevision, std::min(revision, m_publishedRevision));
+}
+void ScrollingSceneWC::requestComposition()
+{
+    Locker publicationLocker { m_publicationLock };
+    Vector<Ref<ScrollingLayerWC>> layers;
+    Publisher publish;
+    uint64_t revision;
+    {
+        Locker locker { m_lock };
+        // Retain resolved layers until after the registry lock is released.
+        // Dropping the last reference under that lock would reenter removeLayer.
+        Vector<PlatformLayerIdentifier> expired;
+        for (auto& entry : m_layers) {
+            if (RefPtr layer = entry.value.get()) layers.append(layer.releaseNonNull());
+            else expired.append(entry.key);
+        }
+        for (auto identifier : expired) m_layers.remove(identifier);
+        publish = m_publisher;
+        if (!publish) return;
+        revision = ++m_revision;
+    }
+    Vector<WCScrollLayerPosition> updates;
+    for (auto& layer : layers) {
+        if (auto update = layer->takePositionUpdate()) updates.append(WTF::move(*update));
+    }
+    if (publish && !updates.isEmpty()) {
+        {
+            Locker locker { m_lock };
+            m_publishedRevision = revision;
+        }
+        publish(revision, WTF::move(updates));
+    }
+}
+ScrollingPlatformLayer* LayerRepresentation::platformLayerFromGraphicsLayer(GraphicsLayer& layer)
+{
+    return layer.scrollingLayerWC();
+}
+}
