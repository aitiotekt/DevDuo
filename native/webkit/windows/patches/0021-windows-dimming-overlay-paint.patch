+        if (strip.isEmpty() || static_cast<uint64_t>(strip.width()) * strip.height() > maximumStripPixels)
+            return false;
+        auto colorSpace = ColorSpace::SRGB();
+        auto snapshot = snapshotFrameRect(frame(), strip, { { SnapshotFlags::PaintEverythingExcludingSelection },
+            PixelFormat::BGRA8, colorSpace }, &overlay);
+        if (!snapshot)
+            return false;
