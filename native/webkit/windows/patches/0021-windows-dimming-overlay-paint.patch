+            { { }, snapshot->truncatedLogicalSize() });
+        if (!pixels)
+            return false;
+        auto bytes = pixels->bytes();
+        for (size_t alpha = 3; alpha < bytes.size(); alpha += 4) {
+            if (bytes[alpha])
