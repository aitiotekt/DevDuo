+#if PLATFORM(WIN) && ENABLE(ASYNC_SCROLLING)
+void RemoteWCLayerTreeHost::publishHostFrame(uint64_t pageProxyID, uint64_t backingStateID, UpdateInfo&& update, CompletionHandler<void(std::optional<UpdateInfo>)>&& completionHandler)
+{
+    ASSERT(isMainRunLoop());
+    auto* connection = m_connectionToWebProcess ? m_connectionToWebProcess->gpuProcess().parentProcessConnection() : nullptr;
+    if (!connection || !pageProxyID) {
+        completionHandler(std::nullopt);
+        return;
+    }
+    // The reply is held by the UI process until it copies or rejects this lease.
+    // No Web-process main-thread hop stands between GPU completion and display.
+    connection->sendWithAsyncReply(Messages::GPUProcessProxy::DidRenderHostFrame(
+        pageProxyID, m_webProcessIdentifier, backingStateID, WTF::move(update)),
+        [weakThis = WeakPtr { *this }, completionHandler = WTF::move(completionHandler)](bool presented) mutable {
+            if (weakThis && !presented) {
+                auto* holder = weakThis->m_sharedSceneContextHolder.get();
+                remoteGraphicsStreamWorkQueue().dispatch([holder] {
+                    if (holder->context) holder->context->discardHostFrame();
+                });
+            }
+            // Returning no bitmap releases DrawingAreaWC's normal rendering
+            // backpressure after the UI lease completes, without double paint.
+            completionHandler(std::nullopt);
+        }, 0);
+}
+#endif
