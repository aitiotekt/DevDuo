+#include <wtf/Assertions.h>
+#include <windows.h>
+
+namespace WebKit {
+
+// WTF's Windows monotonic clock is anchored independently per process. Frame
+// correlation needs one machine-wide clock, including the original input.
+inline double hostFrameClockSeconds()
+{
+    static const auto frequency = [] {
+        LARGE_INTEGER result;
+        RELEASE_ASSERT(QueryPerformanceFrequency(&result));
+        return result.QuadPart;
+    }();
+    LARGE_INTEGER counter;
+    RELEASE_ASSERT(QueryPerformanceCounter(&counter));
+    return static_cast<double>(counter.QuadPart) / frequency;
+}
+
+} // namespace WebKit
+#endif
