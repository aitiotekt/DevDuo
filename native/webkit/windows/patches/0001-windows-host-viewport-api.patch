diff --git a/Source/WebCore/platform/HostScrollIndicator.cpp b/Source/WebCore/platform/HostScrollIndicator.cpp
new file mode 100644
index 0000000..1786d48
--- /dev/null
+++ b/Source/WebCore/platform/HostScrollIndicator.cpp
@@ -0,0 +1,115 @@
+#include "config.h"
+#include "HostScrollIndicator.h"
+
+#if PLATFORM(WIN)
+#include "Document.h"
+#include "DocumentPage.h"
+#include "LocalFrame.h"
+#include "LocalFrameInlines.h"
+#include "LocalFrameView.h"
+#include "Page.h"
+#include "ScrollableArea.h"
+#include "Scrollbar.h"
+#include <wtf/MonotonicTime.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/WeakHashMap.h>
+
+namespace WebCore {
+namespace {
+struct State {
+    bool enabled { false }, userIntent { false };
+    WeakPtr<Document, WeakPtrImplWithEventTargetData> document;
+    uint64_t epoch { 0 }, sequence { 0 };
+    MonotonicTime lastMotion;
+    IntSize viewport;
+    int range { 0 };
+};
+// There is exactly one store in WebCore, shared through the exported API.
+auto& states()
+{
+    static NeverDestroyed<WeakHashMap<Page, State>> storage;
+    return storage.get();
+}
+LocalFrameView* rootView(const ScrollableArea& area)
+{
+    if (!is<ScrollView>(area)) return nullptr;
+    auto* view = dynamicDowncast<LocalFrameView>(downcast<ScrollView>(area));
+    return view && view->frame().isMainFrame() ? const_cast<LocalFrameView*>(view) : nullptr;
+}
+State* stateFor(LocalFrameView& view)
+{
+    auto* page = view.frame().page();
+    if (!page) return nullptr;
+    auto iterator = states().find(page);
+    if (iterator == states().end() || !iterator->value.enabled) return nullptr;
+    auto& state = iterator->value;
+    if (state.document.get() != view.frame().document()) {
+        state.document = view.frame().document();
+        ++state.epoch;
+        state.sequence = 0;
+        state.userIntent = false;
+        state.viewport = { };
+        state.range = 0;
+    }
+    return &state;
+}
+}
+void setHostScrollIndicatorEnabled(Page& page, bool enabled)
+{
+    states().ensure(page, [] { return State { }; }).iterator->value.enabled = enabled;
+}
+bool suppressHostVerticalScrollbar(const ScrollableArea& area)
+{
+    auto* view = rootView(area);
+    return view && stateFor(*view);
+}
+void hostScrollIndicatorUserIntent(ScrollableArea& area)
+{
+    auto* view = rootView(area);
+    auto* state = view ? stateFor(*view) : nullptr;
+    if (!state || area.currentScrollType() != ScrollType::User) return;
+    state->userIntent = true;
+    state->lastMotion = MonotonicTime::now();
+}
+void hostScrollIndicatorProgrammaticIntent(ScrollableArea& area)
+{
+    auto* view = rootView(area);
+    if (auto* state = view ? stateFor(*view) : nullptr) state->userIntent = false;
+}
+void hostScrollIndicatorDidScroll(ScrollableArea& area, int deltaY)
+{
+    auto* view = rootView(area);
+    auto* state = view ? stateFor(*view) : nullptr;
+    if (!state || !deltaY) return;
+    auto range = view->maximumScrollPosition().y() - view->minimumScrollPosition().y();
+    auto viewport = view->visibleContentRect().size();
+    // Layout clamps and anchoring must not borrow a nearby user-input epoch.
+    if (state->range != range || state->viewport != viewport) {
+        state->range = range;
+        state->viewport = viewport;
+        state->userIntent = false;
+        return;
+    }
+    auto now = MonotonicTime::now();
+    if (state->userIntent && now - state->lastMotion < 1_s && area.currentScrollType() == ScrollType::User) {
+        ++state->sequence;
+        state->lastMotion = now;
+    }
+}
+HostScrollIndicatorState hostScrollIndicatorState(LocalFrameView& view)
+{
+    auto* state = stateFor(view);
+    if (!state) return { };
+    state->range = view.maximumScrollPosition().y() - view.minimumScrollPosition().y();
+    state->viewport = view.visibleContentRect().size();
+    RefPtr scrollbar = view.verticalScrollbar();
+    bool nativeVisibilityHidden = static_cast<ScrollableArea&>(view).verticalNativeScrollbarVisibility() == NativeScrollbarVisibility::HiddenByStyle;
+    bool suppressed = view.scrollbarWidthStyle() == ScrollbarWidth::None
+        || nativeVisibilityHidden
+        || (scrollbar && (scrollbar->isHiddenByStyle() || scrollbar->width() <= 0));
+    return { true, suppressed, nativeVisibilityHidden, state->epoch, state->sequence,
+        static_cast<double>(view.scrollPosition().y() - view.minimumScrollPosition().y()),
+        static_cast<double>(state->range), static_cast<double>(state->viewport.height()) };
+}
+}
+#endif
diff --git a/Source/WebCore/platform/HostScrollIndicator.h b/Source/WebCore/platform/HostScrollIndicator.h
new file mode 100644
