+bool WKViewSetHostPresentationGeometry(WKViewRef viewRef, WKSize logicalSize, float backingScaleFactor)
+{
+    if (!viewRef || !std::isfinite(logicalSize.width) || !std::isfinite(logicalSize.height) || !std::isfinite(backingScaleFactor))
+        return false;
+    bool clearsGeometry = !logicalSize.width && !logicalSize.height && !backingScaleFactor;
+    if (!clearsGeometry && (logicalSize.width < 1 || logicalSize.height < 1 || logicalSize.width > 32767 || logicalSize.height > 32767 || std::floor(logicalSize.width) != logicalSize.width || std::floor(logicalSize.height) != logicalSize.height || backingScaleFactor <= 0 || backingScaleFactor > 16))
+        return false;
+    auto* view = toImpl(viewRef);
+    if (!view->page() || view->page()->isClosed())
+        return false;
+    view->setHostPresentationGeometry(toIntSize(logicalSize), backingScaleFactor);
+    return true;
+}
+
+bool WKViewSetObscuredContentInsets(WKViewRef viewRef, float top, float right, float bottom, float left)
+{
+    if (!viewRef || !std::isfinite(top) || !std::isfinite(right) || !std::isfinite(bottom) || !std::isfinite(left)
+        || top < 0 || right < 0 || bottom < 0 || left < 0)
+        return false;
+    auto* view = toImpl(viewRef);
+    auto* page = view->page();
+    auto size = view->viewSize();
+    if (!page || page->isClosed() || left + right >= size.width() || top + bottom >= size.height())
+        return false;
+    page->setObscuredContentInsets({ top, right, bottom, left });
+    return true;
+}
+
+bool WKViewSetUnobscuredSizeRange(WKViewRef viewRef, WKSize minimum, WKSize maximum)
+{
+    if (!viewRef || !std::isfinite(minimum.width) || !std::isfinite(minimum.height)
+        || !std::isfinite(maximum.width) || !std::isfinite(maximum.height)
+        || minimum.width < 0 || minimum.height < 0 || maximum.width < minimum.width || maximum.height < minimum.height
+        || maximum.width > std::numeric_limits<float>::max() || maximum.height > std::numeric_limits<float>::max())
+        return false;
+    bool clearsRange = !minimum.width && !minimum.height && !maximum.width && !maximum.height;
+    if (!clearsRange && (!minimum.width || !minimum.height))
+        return false;
+    auto* page = toImpl(viewRef)->page();
+    if (!page || page->isClosed())
+        return false;
+    WebCore::FloatSize minimumSize { static_cast<float>(minimum.width), static_cast<float>(minimum.height) };
+    WebCore::FloatSize maximumSize { static_cast<float>(maximum.width), static_cast<float>(maximum.height) };
+    page->setDefaultUnobscuredSize(maximumSize);
+    page->setMinimumUnobscuredSize(minimumSize);
+    page->setMaximumUnobscuredSize(maximumSize);
+    return true;
+}
