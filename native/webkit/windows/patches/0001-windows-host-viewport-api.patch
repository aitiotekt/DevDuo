--- /dev/null
+++ b/Source/WebCore/platform/HostScrollIndicator.h
@@ -0,0 +1,26 @@
+// Host presentation policy; this API never changes layout or scroll extents.
+#pragma once
+
+#if PLATFORM(WIN)
+#include <cstdint>
+
+namespace WebCore {
+class Page;
+class LocalFrameView;
+class ScrollableArea;
+struct HostScrollIndicatorState {
+    bool enabled { false };
+    bool cssSuppressed { false };
+    bool nativeVisibilityHidden { false };
+    uint64_t documentEpoch { 0 };
+    uint64_t userMotionSequence { 0 };
+    double position { 0 }, range { 0 }, viewportHeight { 0 };
+};
+WEBCORE_EXPORT void setHostScrollIndicatorEnabled(Page&, bool);
+WEBCORE_EXPORT HostScrollIndicatorState hostScrollIndicatorState(LocalFrameView&);
+bool suppressHostVerticalScrollbar(const ScrollableArea&);
+void hostScrollIndicatorUserIntent(ScrollableArea&);
+void hostScrollIndicatorProgrammaticIntent(ScrollableArea&);
+void hostScrollIndicatorDidScroll(ScrollableArea&, int deltaY);
+}
+#endif
