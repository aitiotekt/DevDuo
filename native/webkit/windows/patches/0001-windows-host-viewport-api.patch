+void WebPage::getHostScrollIndicatorState(CompletionHandler<void(uint32_t, uint32_t, uint64_t, uint64_t, double, double, double)>&& callback)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr view = frame ? frame->view() : nullptr;
+    if (!view) { callback(1, 0, 0, 0, 0, 0, 0); return; }
+    view->updateLayoutAndStyleIfNeededRecursive();
+    auto state = WebCore::hostScrollIndicatorState(*view);
+    uint32_t flags = (state.enabled ? 1u : 0u) | (state.cssSuppressed ? 2u : 0u);
+    if (RefPtr scrollbar = view->verticalScrollbar()) {
+        flags |= 4u | (scrollbar->isCustomScrollbar() ? 8u : 0u) | (scrollbar->width() <= 0 ? 16u : 0u)
+            | (scrollbar->isHiddenByStyle() ? 32u : 0u)
+            | (static_cast<uint32_t>(std::clamp(scrollbar->width(), 0, 65535)) << 16);
+    }
+    if (state.nativeVisibilityHidden) flags |= 64u;
+    callback(0, flags, state.documentEpoch,
+        state.userMotionSequence, state.position, state.range, state.viewportHeight);
+}
+void WebPage::getHostFixedContainerColors(CompletionHandler<void(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t)>&& callback)
+{
+    RefPtr frame = m_mainFrame->coreLocalFrame();
+    RefPtr view = frame ? frame->view() : nullptr;
+    if (!view) {
+        callback(1, 0, 0, 0, 0, 0);
+        return;
+    }
+    view->updateLayoutAndStyleIfNeededRecursive();
+    // Reuse native hit testing, backdrop recognition and alpha blending. Do not
+    // mutate the page's color-history cache or extend any DOM layout rectangle.
+    auto [edges, elements] = view->fixedContainerEdges({ BoxSide::Top, BoxSide::Right, BoxSide::Bottom, BoxSide::Left });
+    uint32_t states = 0;
+    auto colorForSide = [&](BoxSide side, unsigned shift) -> uint32_t {
+        if (!edges.hasFixedEdge(side))
+            return 0;
+        auto color = edges.predominantColor(side);
+        if (!color.isValid() || !color.isOpaque()) {
+            states |= 2u << shift;
+            return 0;
+        }
+        auto [r, g, b, a] = color.toColorTypeLossy<SRGBA<uint8_t>>().resolved();
+        states |= 1u << shift;
+        return (static_cast<uint32_t>(r) << 16) | (static_cast<uint32_t>(g) << 8) | b;
+    };
+    auto top = colorForSide(BoxSide::Top, 0);
+    auto right = colorForSide(BoxSide::Right, 2);
+    auto bottom = colorForSide(BoxSide::Bottom, 4);
+    auto left = colorForSide(BoxSide::Left, 6);
+    callback(0, states, top, right, bottom, left);
+}
