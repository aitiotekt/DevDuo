+void WKViewRequestContentEdgeColor(WKViewRef viewRef, int x, int y, int width, int height,
+    unsigned long long requestID, const void* context, WKContentColorCallback callback)
+{
+    if (!callback)
+        return;
+    if (!viewRef || x < 0 || y < 0 || width < 1 || height < 1 || width > 32767 || height > 18) {
+        callback(requestID, 1, 0, context);
+        return;
+    }
+    auto* view = toImpl(viewRef);
+    auto* page = view->page();
+    auto size = view->viewSize();
+    if (!page || page->isClosed() || x > size.width() - width || y > size.height() - height) {
+        callback(requestID, 1, 0, context);
+        return;
+    }
+    WebCore::IntRect rect { x, y, width, height };
+    // Snapshot painting uses a uniform scale and can crop a rounded thumbnail
+    // size. Read the complete small strip, then area-resample it internally.
+    page->takeSnapshotLegacy(rect, rect.size(), { SnapshotOption::InViewCoordinates, SnapshotOption::ExcludeDeviceScaleFactor, SnapshotOption::Shareable, SnapshotOption::ExcludeSelectionHighlighting },
+        [requestID, context, callback](std::optional<WebCore::ShareableBitmap::Handle>&& handle) {
+            if (!handle) {
+                callback(requestID, 2, 0, context);
+                return;
+            }
+            auto bitmap = WebCore::ShareableBitmap::create(WTF::move(*handle), WebCore::SharedMemory::Protection::ReadOnly);
+            if (!bitmap || bitmap->size().isEmpty()) {
+                callback(requestID, 2, 0, context);
+                return;
+            }
+            auto format = bitmap->pixelFormat();
+            bool bgra = format == WebCore::PixelFormat::BGRA8 || format == WebCore::PixelFormat::BGRX8;
+            bool opaque = format == WebCore::PixelFormat::BGRX8 || format == WebCore::PixelFormat::RGBX8;
+            if (!bgra && format != WebCore::PixelFormat::RGBA8 && format != WebCore::PixelFormat::RGBX8) {
+                callback(requestID, 3, 0, context);
+                return;
+            }
+            auto bytes = bitmap->span();
+            const int sourceWidth = bitmap->size().width(), sourceHeight = bitmap->size().height();
+            const int outputHeight = std::max(1, static_cast<int>(std::lround(64.0 * sourceHeight / sourceWidth)));
+            double red = 0, green = 0, blue = 0;
+            unsigned count = 0;
+            for (int row = 0; row < outputHeight; ++row) {
+                const double top = static_cast<double>(row) * sourceHeight / outputHeight;
+                const double bottom = static_cast<double>(row + 1) * sourceHeight / outputHeight;
+                for (int column = 0; column < 64; ++column) {
+                    const double left = static_cast<double>(column) * sourceWidth / 64;
+                    const double right = static_cast<double>(column + 1) * sourceWidth / 64;
+                    double alpha = 0, r = 0, g = 0, b = 0;
+                    for (int y = static_cast<int>(top); y < std::min(sourceHeight, static_cast<int>(std::ceil(bottom))); ++y) {
+                        for (int x = static_cast<int>(left); x < std::min(sourceWidth, static_cast<int>(std::ceil(right))); ++x) {
+                            const double weight = (std::min(bottom, y + 1.0) - std::max(top, static_cast<double>(y)))
+                                * (std::min(right, x + 1.0) - std::max(left, static_cast<double>(x)));
+                            const auto offset = y * bitmap->bytesPerRow() + x * 4;
+                            alpha += (opaque ? 255 : bytes[offset + 3]) * weight;
+                            r += bytes[offset + (bgra ? 2 : 0)] * weight;
+                            g += bytes[offset + 1] * weight;
+                            b += bytes[offset + (bgra ? 0 : 2)] * weight;
+                        }
+                    }
+                    if (alpha <= 25.5 * (bottom - top) * (right - left))
+                        continue;
+                    red += std::min(255.0, r * 255.0 / alpha);
+                    green += std::min(255.0, g * 255.0 / alpha);
+                    blue += std::min(255.0, b * 255.0 / alpha);
+                    ++count;
+                }
+            }
+            if (!count) {
+                callback(requestID, 2, 0, context);
+                return;
+            }
+            auto rgb = (static_cast<unsigned>(std::lround(red / count)) << 16)
+                | (static_cast<unsigned>(std::lround(green / count)) << 8)
+                | static_cast<unsigned>(std::lround(blue / count));
+            callback(requestID, 0, rgb, context);
+        });
+}
