{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "scripts/**/*.mts",
      "docsite/.vitepress/config.mts",
      "package.json",
      "docsite/package.json",
      "biome.json",
      "tsconfig.json",
      "tsconfig.base.json",
      "tsconfig.scripts.json",
      "tsconfig.tests.json",
      "docsite/tsconfig.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
