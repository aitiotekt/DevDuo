<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/DevDuo/AppLocalization.cs" Link="AppLocalization.cs" />
    <Compile Include="../../src/DevDuo/PreferenceStore.cs" Link="PreferenceStore.cs" />
    <Compile Include="../../src/DevDuo/CalibrationUrl.cs" Link="CalibrationUrl.cs" />
    <Compile Include="../../src/DevDuo/NavigationState.cs" Link="NavigationState.cs" />
    <Compile Include="../../src/DevDuo/DeviceProfile.cs" Link="DeviceProfile.cs" />
    <Compile Include="../../src/DevDuo/SafariScene.cs" Link="SafariScene.cs" />
    <Compile Include="../../src/DevDuo/SafariContainerOptions.cs" Link="SafariContainerOptions.cs" />
    <EmbeddedResource Include="../../src/DevDuo/Localization/*.json" LogicalName="DevDuo.Localization.%(Filename).json" />
    <None Include="../../config/**" Link="config/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/DevDuo/Fixtures/color-scroll.html" Link="color-scroll.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
